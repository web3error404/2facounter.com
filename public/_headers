# Cloudflare Pages header rules — served from dist/ at build time
# (public/ is copied verbatim into dist/)

# Hashed, immutable build assets — cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must revalidate so updates ship immediately
/sw.js
  Cache-Control: no-cache

# Site-wide security headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
  Strict-Transport-Security: max-age=31536000
  # Keep in sync with SECURITY_HEADERS in worker.mjs. The only scripts are
  # first-party inline ones (mirror-host noindex guard, SW registration);
  # every tracker (GTM/GA, Cloudflare Insights beacon) was removed in
  # 2026-11 — the site ships zero third-party scripts and makes no
  # third-party requests, matching the claims on /privacy/.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
