{
  "name": "2FA COUNTER",
  "short_name": "2FA LIVE",
  "description": "A zero-knowledge 2FA authenticator that runs entirely in your browser. Paste a secret key, get a live TOTP/HOTP code — no phone, no app account, no servers.",
