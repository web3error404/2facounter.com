---
// Fonts are bundled locally at build time — all first-party assets
// (fonts, QR decoder) are served from this domain. Third-party requests are
// the Google tag (GTM-WK4QDCS8, in <head> below) and the Cloudflare Web
// Analytics RUM beacon below (cookieless, aggregate performance data only),
// the latter self-managed so it is version-controlled and never silently
// toggled at the edge.
import '@fontsource-variable/fredoka';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
// Preload sources: importing the exact same .woff2 files with ?url makes Vite
// resolve the content-hashed /_astro/ URL at build time — the preloads can
// never drift from the @font-face URLs after a fontsource version bump.
// (Titan One was dropped: the "2FA COUNTER" wordmark and the 404 stamp are
// static SVG outlines now — see components/Wordmark.astro.)
import fredokaLatinWoff2 from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jetbrainsMonoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import DeliBackdrop from '../components/DeliBackdrop.astro';
import SEO from '../components/SEO.astro';
import { LANGUAGES } from '../i18n/languages';

interface Props {
  title: string;
  description: string;
  /** Relative path for canonical + og:URL construction */
  path?: string;
  /** Social-share image path, relative to the site root (defaults to /og.webp) */
  image?: string;
  /** BCP 47 language of the page (defaults to "en") */
  lang?: string;
  /** hreflang alternates for translated versions of this page */
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Force the page out of the index (dev-only pages) */
  noindex?: boolean;
  /** Additional JSON-LD graph to inject */
  jsonLd?: object[];
  /** Render page without the marketing header/footer chrome */
  bare?: boolean;
  /** Article published date ISO 8601 (for guide/article pages) */
  datePublished?: string;
  /** Article modified date ISO 8601 (for guide/article pages) */
  dateModified?: string;
}

const {
  title,
  description,
  path = '/',
  image = '/og.webp',
  lang = 'en',
  alternates,
  noindex,
  jsonLd = [],
  datePublished,
  dateModified,
} = Astro.props;
const isDev = import.meta.env.DEV;
/* RTL: Arabic pages must render right-to-left; every other language is LTR.
   Technical elements (code blocks, key inputs, token display) carry explicit
   dir="ltr" so identifiers and otpauth:// URIs never mirror. */
const dir = lang.toLowerCase().startsWith('ar') ? 'rtl' : 'ltr';

/* ── Non-English language versions: keep live, keep out of search ──────
   The translated locale pages are AI-assisted translations awaiting a
   per-language human review pass. Until each language is reviewed and
   signed off by a reader, every locale page auto-noindexes (and its
   hreflang cluster drops — noindexed pages must not belong to hreflang
   sets), and locale URLs stay out of the sitemap (astro.config.mjs).
   Flip one line when each language ships: remove its dir from
   RELEASED_LOCALES below. */
/* Released 2026-11-09 after a full translation QA pass across all ten
   locales (index + what-is-2fa read in full; no MT artifacts, placeholders
   intact, regional orthography verified). Roll back by restoring [] —
   hreflang + sitemap follow automatically. */
const RELEASED_LOCALES: string[] = [
  'vi', 'zh-cn', 'zh-tw', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it',
  // 2026-11-09: hi / ar / bn / ru added with the language-switcher reorder.
  'hi', 'ar', 'bn', 'ru',
];
const UNRELEASED_LOCALE_DIRS = LANGUAGES.filter(
  (l) => l.href !== '/' && !RELEASED_LOCALES.includes(l.href.replace(/\//g, '')),
).map((l) => l.href.replace(/\//g, ''));
const pathLocale = Astro.url.pathname.split('/')[1] ?? '';
const unreviewedLocale = UNRELEASED_LOCALE_DIRS.includes(pathLocale);
/* Indexed (English) pages must not declare hreflang alternates pointing at
   noindexed/unreviewed locale URLs — filter those out centrally. */
const reviewedAlternates = alternates?.filter(
  (a) => !UNRELEASED_LOCALE_DIRS.includes(
    new URL(a.href, 'https://2facounter.com').pathname.split('/')[1],
  ),
);

// Site-wide Organization JSON-LD — injected on every page so Google can
// associate all pages with a single publisher entity. SameAs stays empty
// until real, verified profiles exist — an invented one is "dishonest
// declarations" bait.
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '2FA COUNTER',
  url: 'https://2facounter.com',
  logo: 'https://2facounter.com/apple-touch-icon.png',
  sameAs: [],
  description:
    'Free, browser-based 2FA authenticator and TOTP code generator. Zero-knowledge, no accounts, no servers.',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'mailto:support@2facounter.com',
      availableLanguage: 'en',
    },
    {
      '@type': 'ContactPoint',
      contactType: 'security',
      email: 'mailto:security@2facounter.com',
      availableLanguage: 'en',
    },
  ],
};

const allJsonLd = [orgJsonLd, ...jsonLd];

// ── Search-engine ownership verification ──────────────────────────────
// 1. Add your site at https://search.google.com/search-console → choose
//    "HTML tag" verification → copy the content token into the string below.
// 2. Same at https://www.bing.com/webmasters (imports settings from Google
//    automatically; provides its own token for the two-step verify).
// 3. After verifying in Search Console: Sitemaps → submit
//    https://2facounter.com/sitemap-index.xml. Bing File sitemaps tab takes
//    the same URL.
// Rebuild after pasting; the metas render only when non-empty.
// Tokens are read from PUBLIC_GSC_TOKEN / PUBLIC_BING_TOKEN so you can set
// them in a local .env file (never committed) or the CI environment without
// touching code. Unset variables fall back to '' and emit nothing.
const googleVerification = import.meta.env.PUBLIC_GSC_TOKEN ?? '';
const bingVerification = import.meta.env.PUBLIC_BING_TOKEN ?? '';

// ── Google tag (GTM-WK4QDCS8) allowed hosts ───────────────────────────
// The Google tag only loads when the page is served from a host in this
// list, keeping test/mirror traffic out of real analytics. The canonical
// apex is always tracked; additional hosts (e.g. a future staging domain)
// go in PUBLIC_ANALYTICS_EXTRA_HOSTS in a local .env (never committed) or
// the CI environment — comma-separated, exact hostnames, no slashes:
//   PUBLIC_ANALYTICS_EXTRA_HOSTS="staging.2facounter.com,other.example"
// Rebuild after changing; unset falls back to apex-only tracking.
// JSON-serializable array, injected verbatim into the inline script below
// via define:vars (exact-match includes() avoids substring matches like
// "2facounter.com.evil.test").
const analyticsHosts = [
  '2facounter.com',
  ...((import.meta.env.PUBLIC_ANALYTICS_EXTRA_HOSTS ?? '')
    .split(',')
    .map((h) => h.trim())
    .filter(Boolean)),
];

// ── Cookie-consent banner copy (analytics consent, GDPR / ePrivacy) ────
// GA/GTM loads ONLY after the visitor accepts; the banner strings are
// localized for every released site language. Keep in sync with the
// privacy policy's Cookies section.
const consentCopy: Record<string, { text: string; accept: string; decline: string; policy: string }> = {
  en: {
    text: 'We use anonymous analytics cookies to understand traffic. Your keys never leave your browser — that part never changes.',
    accept: 'Accept analytics',
    decline: 'Decline',
    policy: 'Privacy policy',
  },
  es: {
    text: 'Usamos cookies de análisis anónimas para entender el tráfico. Tus claves nunca salen de tu navegador — eso nunca cambia.',
    accept: 'Aceptar',
    decline: 'Rechazar',
    policy: 'Política de privacidad',
  },
  pt: {
    text: 'Usamos cookies de análise anônimas para entender o tráfego. Suas chaves nunca saem do seu navegador — isso nunca muda.',
    accept: 'Aceitar',
    decline: 'Recusar',
    policy: 'Política de privacidade',
  },
  fr: {
    text: 'Nous utilisons des cookies de mesure d\u2019audience anonymes pour comprendre le trafic. Vos clés ne quittent jamais votre navigateur — cela ne changera jamais.',
    accept: 'Accepter',
    decline: 'Refuser',
    policy: 'Confidentialité',
  },
  de: {
    text: 'Wir verwenden anonyme Analyse-Cookies, um den Traffic zu verstehen. Ihre Schlüssel verlassen niemals Ihren Browser — das ändert sich nie.',
    accept: 'Akzeptieren',
    decline: 'Ablehnen',
    policy: 'Datenschutz',
  },
  it: {
    text: 'Usiamo cookie analitici anonimi per capire il traffico. Le tue chiavi non lasciano mai il browser — questo non cambia mai.',
    accept: 'Accetta',
    decline: 'Rifiuta',
    policy: 'Privacy',
  },
  ja: {
    text: 'アクセス解析のため、匿名の分析Cookieを使用します。シークレットキーがブラウザの外へ送られることは決してありません。',
    accept: '同意する',
    decline: '拒否',
    policy: 'プライバシー',
  },
  ko: {
    text: '익명 트래픽 분석을 위해 분석 쿠키를 사용합니다. 키는 절대 브라우저 밖으로 전송되지 않습니다.',
    accept: '동의',
    decline: '거부',
    policy: '개인정보 처리방침',
  },
  'zh-cn': {
    text: '我们使用匿名分析 Cookie 来了解流量。你的密钥绝不会离开你的浏览器——这一点永远不会改变。',
    accept: '同意',
    decline: '拒绝',
    policy: '隐私政策',
  },
  'zh-tw': {
    text: '我們使用匿名分析 Cookie 來了解流量。你的金鑰絕不會離開你的瀏覽器——這一點永遠不會改變。',
    accept: '同意',
    decline: '拒絕',
    policy: '隱私權政策',
  },
  ru: {
    text: 'Мы используем анонимные аналитические cookies, чтобы понимать трафик. Ваши ключи никогда не покидают браузер — это не изменится.',
    accept: 'Принять',
    decline: 'Отклонить',
    policy: 'Конфиденциальность',
  },
  ar: {
    text: 'نستخدم ملفات تعريف ارتباط تحليلية مجهولة لفهم حركة الزيارات. مفاتيحك لا تغادر متصفحك أبدًا — وهذا لن يتغير أبدًا.',
    accept: 'قبول',
    decline: 'رفض',
    policy: 'الخصوصية',
  },
  hi: {
    text: 'हम ट्रैफ़िक समझने के लिए गुमनाम एनालिटिक्स कुकीज़ का उपयोग करते हैं। आपकी चाबियाँ कभी ब्राउज़र नहीं छोड़तीं — यह कभी नहीं बदलेगा।',
    accept: 'स्वीकार करें',
    decline: 'अस्वीकार करें',
    policy: 'गोपनीयता',
  },
  bn: {
    text: 'আমরা ট্রাফিক বোঝার জন্য নাম-গোপন বিশ্লেষণ কুকি ব্যবহার করি। আপনার কী কখনো ব্রাউজার ছাড়ে না — এটি কখনো বদলাবে না।',
    accept: 'গ্রহণ করুন',
    decline: 'প্রত্যাখ্যান',
    policy: 'গোপনীয়তা',
  },
  vi: {
    text: 'Chúng tôi dùng cookie phân tích ẩn danh để hiểu lưu lượng truy cập. Khóa của bạn không bao giờ rời khỏi trình duyệt — điều đó không bao giờ thay đổi.',
    accept: 'Chấp nhận',
    decline: 'Từ chối',
    policy: 'Quyền riêng tư',
  },
};
const consent = consentCopy[lang.toLowerCase()] ?? consentCopy.en;
---

<!doctype html>
<html lang={lang} dir={dir} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Cookie consent + Google tag (Google Analytics via GTM container
        GTM-WK4QDCS8). Consent Mode v2: analytics storage is DENIED by default
        and the GTM script only loads after the visitor accepts the banner;
        declining means Google never loads at all. The banner appears only on
        allowed hosts (same allowlist as before); localhost/test hosts get no
        banner, no analytics, and a JS-injected noindex instead. */}
    {!isDev && (
      <script is:inline define:vars={{ analyticsHosts, consent }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }

        if (analyticsHosts.includes(location.hostname)) {
          // Consent Mode v2 defaults — denied until the visitor chooses.
          gtag('consent', 'default', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });

          var CONSENT_KEY = '2fac.consent.v1';
          var savedConsent = null;
          try { savedConsent = localStorage.getItem(CONSENT_KEY); } catch (e) {}

          function loadGtm() {
            if (document.getElementById('gtm-script')) return;
            var gtmTag = document.createElement('script');
            gtmTag.id = 'gtm-script';
            gtmTag.async = true;
            gtmTag.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-WK4QDCS8';
            document.head.appendChild(gtmTag);
          }
          function grantAnalytics() {
            gtag('consent', 'update', { analytics_storage: 'granted' });
            loadGtm();
          }
          function showConsentBanner() {
            if (document.getElementById('consent-banner')) return;
            var bar = document.createElement('div');
            bar.id = 'consent-banner';
            bar.setAttribute('role', 'region');
            bar.setAttribute('aria-label', 'Cookie consent');
            bar.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:60;background:#2a1f1a;color:#f4ebe1;padding:14px 16px;font-size:14px;line-height:1.5;box-shadow:0 -2px 0 rgba(0,0,0,0.25)';
            bar.innerHTML =
              '<div style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between">'
              + '<p style="margin:0;max-width:640px">' + consent.text
              + ' <a href="/privacy/" style="color:#e87a35;text-decoration:underline">' + consent.policy + '</a></p>'
              + '<div style="display:flex;gap:10px;flex-shrink:0">'
              + '<button type="button" id="consent-accept" style="min-height:44px;padding:8px 18px;border-radius:999px;border:2px solid #e87a35;background:#e87a35;color:#2a1f1a;font-weight:700;cursor:pointer">' + consent.accept + '</button>'
              + '<button type="button" id="consent-decline" style="min-height:44px;padding:8px 18px;border-radius:999px;border:2px solid #f4ebe1;background:transparent;color:#f4ebe1;font-weight:700;cursor:pointer">' + consent.decline + '</button>'
              + '</div></div>';
            document.body.appendChild(bar);
            document.getElementById('consent-accept').addEventListener('click', function () {
              try { localStorage.setItem(CONSENT_KEY, 'granted'); } catch (e) {}
              grantAnalytics();
              bar.remove();
            });
            document.getElementById('consent-decline').addEventListener('click', function () {
              try { localStorage.setItem(CONSENT_KEY, 'denied'); } catch (e) {}
              bar.remove();
            });
          }

          if (savedConsent === 'granted') {
            grantAnalytics();
          } else if (savedConsent !== 'denied') {
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', showConsentBanner);
            } else {
              showConsentBanner();
            }
          }

          // Footer "Cookie settings" hook — lets visitors revisit the choice.
          window.__2facConsentSettings = function () { showConsentBanner(); };
        } else {
          // Any copy of this site served from a non-canonical host (a test or
          // mirror domain) asks search engines not to index it. Google executes
          // JS and honors JS-injected meta robots, and the canonical tags point
          // at the apex regardless — belt and braces so a future staging host
          // can never duplicate or outrank the real site in search.
          var noindexMeta = document.createElement('meta');
          noindexMeta.name = 'robots';
          noindexMeta.content = 'noindex, nofollow';
          document.head.appendChild(noindexMeta);
        }
      </script>
    )}
    <SEO
      title={title}
      description={description}
      canonicalPath={path}
      ogImage={image}
      lang={lang}
      alternates={reviewedAlternates}
      noindex={noindex || unreviewedLocale}
      jsonLd={allJsonLd}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="2FA Counter" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#e87a35" />
    <meta name="generator" content={Astro.generator} />

    <!-- Font preload: the above-the-fold latin variable subsets (Fredoka
         headings, Inter body, JetBrains Mono labels/bylines — the wordmark
         is static SVG, no Titan One preload). JetBrains Mono is preloaded
         too: without it, fast-painting pages (small guides) could paint
         with fallback fonts and reflow on swap (observed CLS 0.16 on
         /guides/github/ at mobile). Hrefs are resolved from the fontsource
         packages themselves (?url import) so they always match the
         @font-face assets — no manual hash refresh ever. crossorigin is
         required even same-origin. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin fetchpriority="high" href={fredokaLatinWoff2} />
    <link rel="preload" as="font" type="font/woff2" crossorigin fetchpriority="high" href={interLatinWoff2} />
    <link rel="preload" as="font" type="font/woff2" crossorigin fetchpriority="high" href={jetbrainsMonoWoff2} />

    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    {!isDev && (
      <script is:inline>
        // PWA: network-first pages + cached assets — fully offline once installed or visited
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      </script>
    )}

    {/* Cloudflare Web Analytics RUM beacon.
        Cookieless, no personal data, no browser storage (per Cloudflare's RUM
        privacy docs). Loaded deferred so it never blocks rendering; fails
        silently offline. Injected at runtime only on the production host so
        localhost previews and the browser test suites see zero beacon noise. */}
    {!isDev && (
      <script is:inline>
        if (location.hostname === '2facounter.com') {
          var cfBeacon = document.createElement('script');
          cfBeacon.defer = true;
          cfBeacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          cfBeacon.setAttribute('data-cf-beacon', '{"token": "f08eeadbd7224b8faf5ba9a985542562"}');
          document.head.appendChild(cfBeacon);
        }
      </script>
    )}
  </head>
  <body class="flex min-h-full flex-col bg-canvas font-sans text-body">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:border-2 focus:border-cream focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:font-bold focus:text-cream"
    >
      Skip to content
    </a>
    <!-- decorative shield-logo tile backdrop, fixed under all content -->
    <DeliBackdrop />
    <slot />
  </body>
</html>
