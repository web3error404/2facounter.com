    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Что такое 2FA? Как работают двухфакторная аутентификация и TOTP',
    description,
    url: 'https://2facounter.com/ru/what-is-2fa/',
    datePublished: '2026-11-07',
    dateModified: '2026-11-09',
    author: { '@type': 'Organization', name: '2FA COUNTER', url: 'https://2facounter.com' },
    publisher: {
      '@type': 'Organization',
      name: '2FA COUNTER',
      url: 'https://2facounter.com',
      logo: { '@type': 'ImageObject', url: 'https://2facounter.com/apple-touch-icon.png' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://2facounter.com/ru/what-is-2fa/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
