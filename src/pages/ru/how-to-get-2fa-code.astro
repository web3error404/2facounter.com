const title = 'Как получить код 2FA: пошаговое руководство (TOTP)';
const description =
  'Как получить код 2FA за три шага: вставьте ключ настройки в онлайн-генератор TOTP и скопируйте живой код — плюс решения, если код не принимается.';

const faq = [
  {
    q: 'Где найти ключ настройки?',
    a: 'На том же экране, где сервис показывает QR-код для своего приложения-аутентификатора. Ищите ссылку вида «не удаётся отсканировать?», «ввести код вручную» или «показать ключ настройки». При её открытии появится строка Base32 (или полный URI otpauth://) — любой из вариантов работает в генераторе.',
  },
  {
    q: 'Код не принимается — что делать?',
    a: 'Почти всегда дело в расхождении часов. TOTP зависит от времени: часы, расходящиеся хотя бы на полминуты, дают недействительные коды. Включите автоматическую синхронизацию системного времени и попробуйте снова.',
  },
  {
    q: 'Это тот же код, что сгенерировало бы приложение на телефоне?',
    a: 'Да. Любое приложение-аутентификатор — Google Authenticator, Authy, Microsoft Authenticator или этот браузерный инструмент — вычисляет один и тот же TOTP-код из RFC 6238 на основе одного и того же секрета и одних и тех же часов. Они взаимозаменяемы.',
  },
  {
    q: 'Коды восстановления всё ещё нужны?',
    a: 'Да. Храните их офлайн, отдельно от этого инструмента. Если вы когда-нибудь потеряете доступ к устройству, где лежит ваш секретный ключ, коды восстановления станут путём назад к аккаунту.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
      { '@type': 'ListItem', position: 2, name: 'Как получить код 2FA', item: 'https://2facounter.com/ru/how-to-get-2fa-code/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Как получить код 2FA с помощью онлайн-генератора TOTP',
    totalTime: 'PT3M',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Включите 2FA и покажите ключ настройки', text: 'Откройте настройки безопасности сервиса, выберите вариант с приложением-аутентификатором и покажите ключ настройки, если не можете отсканировать QR-код.' },
      { '@type': 'HowToStep', position: 2, name: 'Вставьте ключ в генератор', text: 'Вставьте строку Base32 или URI otpauth:// в генератор на главной странице 2FA COUNTER. Всё вычисляется локально в браузере.' },
      { '@type': 'HowToStep', position: 3, name: 'Скопируйте живой код и подтвердите', text: 'Введите 6-значный код на экране проверки сервиса в пределах его 30-секундного окна, чтобы подтвердить настройку, — и повторяйте этот же поток при каждом будущем входе.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

// hreflang cluster for the translated article (+ x-default → English)
const alternates = [
  { hreflang: 'en', href: 'https://2facounter.com/how-to-get-2fa-code/' },
  { hreflang: 'vi', href: 'https://2facounter.com/vi/how-to-get-2fa-code/' },
