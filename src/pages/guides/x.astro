---
import GuideLayout from '../../components/GuideLayout.astro';

const title = 'How to Set Up 2FA on X / Twitter (TOTP, No Phone App)';
const description =
  'Enable two-factor authentication on X (Twitter) with a code generated in your browser. Find the TOTP setup key and generate live codes at 2facounter.com.';
---

<GuideLayout
  serviceName="X"
  title={title}
  description={description}
  path="/guides/x/"
  dateModified="2026-11-11"
  datePublished="2026-11-09"
  lastReviewed="2026-11-11"
  sources={[
    {
      label: 'X Help Centre — How to use two-factor authentication',
      href: 'https://help.x.com/en/managing-your-account/two-factor-authentication',
      kind: 'official',
    },
    {
      label: 'RFC 6238 — TOTP: Time-Based One-Time Password Algorithm',
      href: 'https://www.rfc-editor.org/rfc/rfc6238',
      kind: 'independent',
    },
  ]}
  intro="X (formerly Twitter) offers three 2FA factors — SMS (Premium-only since 2023), authenticator app (TOTP), and security keys — and the app-based one is the free, portable option for every account. A browser authenticator works perfectly — you just have to catch the setup key behind the QR."
  minutes={5}
  params={['6 digits', '30s period', 'SHA-1']}
  ctaTitle="On X, your handle is your reputation"
  ctaBody="A hijacked X account sends scams from your outbox in minutes — years of posts, DMs, and a follower graph get weaponized against you. The Base32 key in an encrypted vault takes one minute and closes the takeover route."
  deepDive={{
    heading: "X-specific traps that trip people up",
    blocks: [
      {
        title: 'Email is the gate, not your phone number',
        body: 'X’s current enrolment requires a confirmed email address — its help centre states that enrolment “will also make sure you have a confirmed email address associated with your account”, and the documented authentication-app flow contains no phone step at all. The phone-number prompt appears in the text-message flow, not the app one. Older Twitter-era guides describe a hard phone gate because enrolment did once require a number; if your account has never confirmed an email, X will stop you at that point instead.',
      },
      {
        title: 'Why the SMS factor is the one to skip',
        body: 'X restricts SMS 2FA to Premium subscribers (and even then, X notes availability may vary by country and carrier), and SMS is also the weakest factor in the stack: a SIM-swap attacker reads those codes without touching your device. The third option, security keys, is the phishing-resistant one if you already own a hardware key or passkey — but TOTP is the factor that adds a real, free second factor computed on your side and portable to any device with the key.',
      },
      {
        title: 'The post-enrollment backup code is your lifeline, not decoration',
        body: 'When you finish verifying, X shows a confirmation screen that may include a one-time backup code — X recommends storing a screenshot of it for future use. Save it into your password-manager vault (or keep the Base32 key next to it) so you can restore the enrollment into a new phone app or browser later — without re-enrolling or contacting X support.',
      },
      {
        title: 'Apps that need your X password stop working',
        body: 'Once 2FA is on, X blocks the usual username-and-password login in other apps that require you to enter your X password. X instead issues a temporary password — either texted to your phone or generated by you under Two-factor authentication → Additional methods → Temporary password — and that’s what those apps need. Your normal login keeps working on x.com and the official apps.',
      },
    ],
  }}
  steps={[
    {
      title: 'Open security settings',
      body: 'Sign in at x.com → “More” in the sidebar → Settings and privacy → Security and account access → Security → Two-factor authentication.',
    },
    {
      title: 'Pick “Authentication app”',
      body: 'Choose the app option (not SMS — X restricts SMS to Premium accounts, and app codes are safer against SIM swaps anyway). X asks for your current password if prompted, and if your account has no confirmed email yet, it will ask you to add and verify one before continuing — documented enrollment behavior, not a trap.',
    },
    {
      title: 'Grab the setup key',
      body: 'X shows a QR code to scan. If a copy/manual-entry link appears beneath the QR, use it to get the Base32 secret; if it doesn’t, screenshot the QR and paste it into the generator — either route gets you the same key.',
    },
    {
      title: 'Generate and verify',
      body: 'Paste the key into 2facounter.com, copy the live 6-digit code, and enter it in X’s confirm dialog. X remembers the enrollment as “Authenticator app”.',
    },
    {
      title: 'Screenshot the confirmation backup code, too',
      body: 'After verifying, watch the confirmation screen. X documents a one-time backup code there for the text-message method, and some app enrolments show one too; its absence for the app method is not an error. If yours does appear, store it in your vault before tapping “Got it” — it regains access if you lose the phone.',
    },
    {
      title: 'Store backups',
      body: 'Save the Base32 key (and that confirmation QR) encrypted in a password manager, and note X’s single-use backup code if prompted — losing it means relying on the key itself.',
    },
  ]}
  faqs={[
    {
      q: 'Does X require a phone number to turn on 2FA?',
      a: 'Not for the authentication-app method. X’s help centre documents a confirmed email address as the enrolment requirement and describes no phone-number step in the app flow; the number prompt belongs to the text-message method. Older guides describe a phone gate because Twitter-era enrolment required one. If your account has never had a confirmed email, X asks you to add and verify one before you can finish enrolling.',
    },
    {
      q: 'Which of X’s three 2FA options is the safe one?',
      a: 'A hardware security key or passkey is the phishing-resistant pick if you have one. Without hardware, TOTP is the factor to choose: SMS is vulnerable to SIM-swap attacks and text-message interception (and Premium-only anyway), while app-based codes change every 30 seconds and are computed locally.',
    },
    {
      q: 'Do the codes work across multiple devices?',
      a: 'Yes — TOTP is deterministic. The same secret pasted in a browser, a phone app, or a second browser profile always produces the same code at the same 30-second step.',
    },
  ]}
/>
