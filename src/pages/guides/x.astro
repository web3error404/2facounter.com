---
import GuideLayout from '../../components/GuideLayout.astro';

const title = 'How to Set Up 2FA on X / Twitter (TOTP, No Phone App)';
const description =
  'Enable two-factor authentication on X (Twitter) with a code generated in your browser. Find the TOTP setup key and generate live codes at 2facounter.com.';
---

<GuideLayout
  serviceName="X"
  title={title}
  description={description}
  path="/guides/x/"
  dateModified="2026-11-09"
  lastReviewed="2026-11-09"
  intro="X (formerly Twitter) offers three 2FA factors — SMS (Premium-only since 2023), authenticator app (TOTP), and security keys — and the app-based one is the free, portable option for every account. A browser authenticator works perfectly — you just have to catch the setup key behind the QR."
  minutes={5}
  params={['6 digits', '30s period', 'SHA-1']}
  ctaTitle="On X, your handle is your reputation"
  ctaBody="A hijacked X account sends scams from your outbox in minutes — years of posts, DMs, and a follower graph get weaponized against you. The Base32 key in an encrypted vault takes one minute and closes the takeover route."
  deepDive={{
    heading: "X-specific traps that trip people up",
    blocks: [
      {
        title: 'The phone-number gate',
        body: 'Accounts without a verified phone number have historically found the two-factor menu hidden — even for the app-based option. Verify a number is registered on the account before you try to enroll. The number doesn’t become your 2FA (app codes are a separate factor); it just has to exist for the section to appear.',
      },
      {
        title: 'Why the SMS factor is the one to skip',
        body: 'X restricts SMS 2FA to Premium subscribers, and SMS is also the weakest factor in the stack: a SIM-swap attacker reads those codes without touching your device. The third option, security keys, is the phishing-resistant one if you already own a hardware key or passkey — but TOTP is the factor that adds a real, free second factor computed on your side and portable to any device with the key.',
      },
      {
        title: 'The post-enrollment QR is your backup, not decoration',
        body: 'When you finish verifying, X shows a confirmation screen that may include a one-time QR labelled “for other devices”. If yours shows it, screenshot it into your password-manager vault (or keep the Base32 key next to it) so you can restore the enrollment into a new phone app or browser later — without re-enrolling or contacting X support.',
      },
    ],
  }}
  steps={[
    {
      title: 'Open security settings',
      body: 'Sign in at x.com → “More” in the sidebar → Settings and privacy → Security and account access → Security → Two-factor authentication.',
    },
    {
      title: 'Pick “Authentication app”',
      body: 'Choose the app option (not SMS — X restricts SMS to Premium accounts, and app codes are safer against SIM swaps anyway). Confirm with your current password if prompted.',
    },
    {
      title: 'Grab the setup key',
      body: 'X shows a QR scan screen. Look for the small copy/manual-entry link beneath the QR to get the Base32 secret, or screenshot the QR and paste it into the generator — both routes work.',
    },
    {
      title: 'Generate and verify',
      body: 'Paste the key into 2facounter.com, copy the live 6-digit code, and enter it in X’s confirm dialog. X remembers the enrollment as “Authenticator app”.',
    },
    {
      title: 'Screenshot the confirmation QR, too',
      body: 'After verifying, X may display a one-time QR “for other devices”. If yours shows it, scan it back into the generator or screenshot it — it lets you restore the same key into any app later without re-enrollment.',
    },
    {
      title: 'Store backups',
      body: 'Save the Base32 key (and that confirmation QR) encrypted in a password manager, and note X’s single-use backup code list if prompted.',
    },
  ]}
  faqs={[
    {
      q: 'Why does X require a phone number for 2FA?',
      a: 'Accounts without a verified phone number have historically not seen the 2FA section — even when they only want the app-based option. The browser authenticator replaces the need for an authenticator app, not the number requirement.',
    },
    {
      q: 'Which of X’s three 2FA options is the safe one?',
      a: 'A hardware security key or passkey is the phishing-resistant pick if you have one. Without hardware, TOTP is the factor to choose: SMS is vulnerable to SIM-swap attacks and text-message interception (and Premium-only anyway), while app-based codes change every 30 seconds and are computed locally.',
    },
    {
      q: 'Do the codes work across multiple devices?',
      a: 'Yes — TOTP is deterministic. The same secret pasted in a browser, a phone app, or a second browser profile always produces the same code at the same 30-second step.',
    },
  ]}
/>
