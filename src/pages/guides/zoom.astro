---
import GuideLayout from '../../components/GuideLayout.astro';

const title = 'How to Set Up 2FA on Zoom (Authenticator App)';
const description =
  'Set up Zoom two-factor authentication with an authenticator app. Scan the QR code or use a setup key, then generate live TOTP codes in your browser.';
---

<GuideLayout
  serviceName="Zoom"
  title={title}
  description={description}
  path="/guides/zoom/"
  datePublished="2026-11-18"
  dateModified="2026-11-23"
    lastReviewed="2026-11-23"
  reviewedPrefix="UI wording and navigation"
  reviewedClaim="unverified — support.zoom.com renders its help articles client-side and could not be read"
  sources={[
    {
      label: 'RFC 6238 — TOTP: Time-Based One-Time Password Algorithm',
      href: 'https://www.rfc-editor.org/rfc/rfc6238',
      kind: 'independent',
    },
  ]}
  intro="Zoom supports authenticator apps for account sign-in, and many organizations enforce 2FA at the account level. Meetings themselves do not usually ask for a code — this protects the account that hosts them. Zoom’s published instructions describe scanning a QR code; if no manual key appears, screenshot the QR and paste the image into the generator."
  minutes={4}
  params={['6 digits', '30 s period', 'SHA-1']}
  ctaTitle="The host account controls the meeting"
  ctaBody="A hijacked Zoom account can schedule meetings as you, access cloud recordings, and change account settings. Store the setup secret and Zoom’s recovery codes in your vault before the next call."
  deepDive={{
    heading: "Zoom account details",
    blocks: [
      {
        title: 'Account-level 2FA versus per-meeting security',
        body: 'Zoom’s two-factor authentication protects sign-in to your Zoom account. Meeting passwords, waiting rooms, and passcodes protect individual meetings. They are separate layers: enabling 2FA does not remove the need for a meeting passcode, and a strong meeting policy does not protect your account.',
      },
      {
        title: 'Admins can enforce 2FA or route sign-in through SSO',
        body: 'On a work or school account, an admin may require 2FA for all users or enforce SSO through an identity provider. If the authenticator option is missing, that is an account policy. Ask your admin which method is allowed; do not try to bypass enforced SSO.',
      },
      {
        title: 'Cloud recordings and connected apps stay sensitive',
        body: 'Signing in with 2FA does not encrypt cloud recordings or revoke access granted to connected apps. After enabling it, review “Apps” and “Recordings” in the Zoom web portal, remove integrations you no longer use, and confirm who can view recorded meetings.',
      },
    ],
  }}
  steps={[
    {
      title: 'Open your Zoom profile',
      body: 'Sign in at zoom.us, then open “Profile” from the left-hand navigation. The direct shortcut is zoom.us/profile.',
    },
    {
      title: 'Go to Two-Factor Authentication',
      body: 'In the “Sign In” section, find “Two-Factor Authentication” and click “Set Up 2FA”. Zoom may ask you to confirm your password.',
    },
    {
      title: 'Choose Authenticator App',
      body: 'Select “Authenticator App” rather than SMS. Open your authenticator app and scan the QR code shown in Zoom. If your device cannot scan the code, look for an option on the setup prompt to enter the setup key manually.',
    },
    {
      title: 'Generate the code',
      body: 'Paste the setup key into 2facounter.com if you have one; otherwise screenshot the QR code and paste the image into the generator. Label it “Zoom”. The live 6-digit code refreshes every 30 seconds, and the decode happens on your device.',
    },
    {
      title: 'Confirm and save recovery codes',
      body: 'After entering your 6-digit verification code to confirm setup, copy or download the recovery codes displayed on screen and store them somewhere safe — ideally your encrypted password manager, alongside the setup secret.',
    },
    {
      title: 'Review account access',
      body: 'Check the “Apps” and “Recordings” sections of the web portal and remove anything unfamiliar. Store the setup secret alongside the recovery codes so a lost phone is an inconvenience, not a lockout.',
    },
  ]}
  faqs={[
    {
      q: 'Does Zoom use standard TOTP?',
      a: 'Yes. Zoom’s authenticator-app method produces standard 6-digit, 30-second TOTP codes with SHA-1. The same secret works in any compatible authenticator, including this browser generator.',
    },
    {
      q: 'Do meeting attendees need 2FA to join?',
      a: 'No. Two-factor authentication protects account sign-in, not meeting attendance. Guests join with a meeting link or ID and passcode as usual; only hosts and signed-in users deal with the account’s 2FA.',
    },
    {
      q: 'Why is the authenticator option missing on my Zoom account?',
      a: 'Your organization may enforce SSO or restrict authentication methods at the account level. In that case the identity provider handles the second factor. Ask your Zoom admin which methods are permitted.',
    },
    {
      q: 'What if I lose my phone and recovery codes?',
      a: 'If you saved the setup secret, paste it into the generator on another device and keep signing in. Without the secret or recovery codes, contact your Zoom account admin or Zoom support — recovery without a second factor is deliberately limited.',
    },
  ]}
/>
