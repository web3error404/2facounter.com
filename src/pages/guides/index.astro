---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = '2FA Setup Guides — Enable 2FA on Any Service, No Phone App';
const description =
  '2FA setup guides for Google, PayPal, Instagram, GitHub, Discord, Coinbase, Binance and more — enable TOTP two-factor authentication in your browser, no app.';

const guides = [
  {
    href: '/guides/google/',
    service: 'Google',
    blurb: '4 min · 6 digits · 30 s',
    text: 'Enable 2-Step Verification with a standard TOTP key — and skip Google Authenticator’s cloud-sync upload.',
  },
  {
    href: '/guides/microsoft/',
    service: 'Microsoft',
    blurb: '5 min · 6 digits · 30 s',
    text: 'Protect Outlook, Windows and Xbox sign-ins with browser-generated codes, no Authenticator app install.',
  },
  {
    href: '/guides/discord/',
    service: 'Discord',
    blurb: '4 min · 6 digits · 30 s',
    text: 'Protect your Discord account and server — enable 2FA and generate codes with or without the mobile app.',
  },
  {
    href: '/guides/github/',
    service: 'GitHub',
    blurb: '4 min · 6 digits · 30 s',
    text: 'Meet GitHub’s mandatory 2FA requirement using TOTP you can regenerate on any shared machine.',
  },
  {
    href: '/guides/x/',
    service: 'X / Twitter',
    blurb: '3 min · 6 digits · 30 s',
    text: 'Turn on app-based 2FA on X — safer than SMS and free for every account that verifies a phone number.',
  },
  {
    href: '/guides/aws/',
    service: 'AWS',
    blurb: '4 min · 6 digits · 30 s',
    text: 'Assign a virtual MFA device to IAM users or root and generate the two consecutive codes AWS demands.',
  },
  {
    href: '/guides/coinbase/',
    service: 'Coinbase',
    blurb: '3 min · 6 digits · 30 s',
    text: 'Lock a crypto exchange account behind TOTP — no phone dependency, no SMS SIM-swap exposure.',
  },
  {
    href: '/guides/kraken/',
    service: 'Kraken',
    blurb: '3 min · 6 digits · 30 s',
    text: 'Set up Kraken’s sign-in TOTP facet and its Master key from any browser you use.',
  },
  {
    href: '/guides/steam/',
    service: 'Steam',
    blurb: '5 min · Steam variant',
    text: 'Steam Guard — the security settings, wallet, trading, and how to generate codes in your browser.',
  },
  {
    href: '/guides/binance/',
    service: 'Binance',
    blurb: '5 min · 6 digits · 30 s',
    text: 'Turn on TOTP 2FA for your Binance account — better withdrawal security without installing apps.',
  },
  {
    href: '/guides/paypal/',
    service: 'PayPal',
    blurb: '4 min · 6 digits · 30 s',
    text: 'Protect a money-moving account with authenticator-app 2FA — and audit the SMS fallback PayPal keeps enrolling.',
  },
  {
    href: '/guides/instagram/',
    service: 'Instagram',
    blurb: '4 min · 6 digits · 30 s',
    text: 'Enable TOTP 2FA via Accounts Center — the method that doesn’t die with your SIM card.',
  },
];
---

<Layout
  title={title}
  description={description}
  path="/guides/"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: '2FA setup guides',
      itemListElement: guides.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${g.service} 2FA setup`,
        url: `https://2facounter.com${g.href}`,
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://2facounter.com/guides/' },
      ],
    },
  ]}
>
  <SiteHeader />
  <main id="main">
    <div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 lg:py-24 xl:px-0">
      <p class="section-label">Guides</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl tracking-normal text-ink sm:text-5xl">
        Set up 2FA on any service — no phone app required
      </h1>
      <p class="mt-4 max-w-2xl text-lg font-medium text-ink">
        Step-by-step instructions for enabling two-factor authentication and keeping your
        authenticator codes reachable from every device you actually use.
      </p>
      <p class="mt-3 max-w-2xl text-sm font-medium text-ink/90">
        Every guide is fact-checked against that service's own documentation and carries a
        visible review date. Steam is the honest exception — Valve's Steam Guard codes can't be
        reproduced by any standards-based generator, and that guide tells you so.
        <a href="/methodology/" class="link">Read our editorial methodology</a>.
      </p>

      <!-- Menu board: cream board, dark header bar, priced line items -->
      <div class="mt-12 overflow-hidden rounded-xl border-4 border-ink bg-cream" style="box-shadow: var(--shadow-card)">
        <div class="on-dark bg-ink px-6 py-4">
          <h2 class="font-display text-xl tracking-[0.0625em] text-primary uppercase">Tonight’s menu — setup guides</h2>
        </div>
        <ul>
          {
            guides.map((g) => (
              <li class="border-t-2 border-dashed border-hairline-strong first:border-t-0">
                <a href={g.href} class="group flex items-start gap-4 px-6 py-5 sm:gap-8">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-bold text-ink group-hover:text-accent-red">{g.service}</h3>
                    <p class="mt-1 text-sm font-medium text-ink">{g.text}</p>
                    <p class="mt-2 font-mono text-label text-muted">{g.blurb}</p>
                  </div>
                  <span class="shrink-0 pt-1 text-right font-numeric text-2xl font-black tracking-[-0.03125em] text-accent-red">
                    {g.blurb.split('·')[0].trim()}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="cta-banner on-dark mt-10">
        <h2 class="font-display text-2xl tracking-normal text-primary">All services, one generator</h2>
        <p class="mt-2 max-w-2xl font-medium text-cream/80">
          Every guide ends in the same place: paste the key, get live codes. The generator
          implements the exact RFC 6238 standard each of these services uses.
        </p>
        <a
          href="/#generator"
          class="btn-primary mt-6 inline-flex"
        >
          Open the generator
        </a>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
