---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ReviewByline from '../../components/ReviewByline.astro';
import { GUIDES } from '../../data/guides';

const title = '2FA Setup Guides — Enable 2FA on Any Service, No Phone App';
const description =
  '2FA setup guides for Google, Amazon, Facebook, Microsoft, GitHub, Discord, Instagram, Dropbox, Binance and more — enable TOTP in your browser, no app.';

const guides = GUIDES;

const faqs = [
  {
    q: 'How do I set up 2FA on an account?',
    a: 'Open the service’s security settings, choose “two-factor authentication” (sometimes “2-step verification” or “MFA”), then pick the authenticator-app option rather than SMS. The service shows a QR code — many offer “can’t scan?” or “enter setup key manually” to reveal the Base32 secret, which you can paste into the generator and confirm with the live 6-digit code. If no manual key appears, screenshot the QR code and paste the image into the generator instead. Save any recovery codes the service offers; those, not the app, are what gets you back in if a device is lost.',
  },
  {
    q: 'Do I need to install an authenticator app?',
    a: 'No. Standard TOTP — the format used by Google, Microsoft, GitHub, Discord, Binance and nearly every service covered here — only needs the shared secret and a correct clock. The generator at 2facounter.com computes the same RFC 6238 codes in your browser, so a laptop, tablet, or any device with a browser can stand in for the phone app.',
  },
  {
    q: 'Which services use standard TOTP?',
    a: 'Most of the big ones: Google, Microsoft, Amazon, Facebook, GitHub, Discord, Instagram, Dropbox, LinkedIn, X, PayPal, Binance, Coinbase, Kraken and AWS all offer an authenticator-app option built on TOTP. Steam is the well-known exception — Steam Guard uses a proprietary variant, so its guide explains what works there instead of pretending a browser generator can produce Steam codes.',
  },
  {
    q: 'The service only shows a QR code — how do I get the key?',
    a: 'Look for a “can’t scan it?”, “enter setup key manually”, or “show secret key” link under the QR code — many services provide one, but not all. If the link is missing, screenshot the QR code and drop the image onto the generator (or scan it with your camera). Decoding happens on your device, and the resulting key stays in the input field only.',
  },
  {
    q: 'Is it safe to paste my 2FA secret into a website?',
    a: 'Only into a site that computes locally and makes no network requests with the key. This generator runs entirely in your browser with the Web Crypto API: there is no server, no account, and no analytics, so the secret never leaves the device. You can verify that claim by loading the page, disconnecting from the internet, and watching the codes keep updating.',
  },
];
---

<Layout
  title={title}
  description={description}
  path="/guides/"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: '2FA setup guides',
      itemListElement: guides.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${g.service} 2FA setup`,
        url: `https://2facounter.com${g.path}`,
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://2facounter.com/guides/' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ]}
  dateModified="2026-11-18"
>
  <SiteHeader />
  <main id="main">
    <div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 lg:py-24 xl:px-0">
      <p class="section-label">Guides</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl tracking-normal text-ink sm:text-5xl">
        Set up 2FA on any service — no phone app required
      </h1>
      <p class="mt-4 max-w-2xl text-lg font-medium text-ink">
        Step-by-step instructions for enabling two-factor authentication and keeping your
        authenticator codes reachable from every device you actually use.
      </p>
      <p class="mt-3 max-w-2xl text-sm font-medium text-ink/90">
        Every guide is fact-checked against that service's own documentation and carries a
        visible review date. Steam is the honest exception — Valve's Steam Guard codes can't be
        reproduced by any standards-based generator, and that guide tells you so.
        <a href="/methodology/" class="link">Read our editorial methodology</a>.
      </p>
      <ReviewByline />

      <!-- Menu board: cream board, dark header bar, priced line items -->
      <div class="mt-12 overflow-hidden rounded-xl border-4 border-ink bg-cream" style="box-shadow: var(--shadow-card)">
        <div class="on-dark bg-ink px-6 py-4">
          <h2 class="font-display text-xl tracking-[0.0625em] text-primary uppercase">Tonight’s menu — setup guides</h2>
        </div>
        <ul>
          {
            guides.map((g) => (
              <li class="border-t-2 border-dashed border-hairline-strong first:border-t-0">
                <a href={g.path} class="group flex items-start gap-4 px-6 py-5 sm:gap-8">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-bold text-ink group-hover:text-accent-red">{g.service}</h3>
                    <p class="mt-1 text-sm font-medium text-ink">{g.text}</p>
                    <p class="mt-2 font-mono text-label text-muted">{g.blurb}</p>
                  </div>
                  <span class="shrink-0 pt-1 text-right font-numeric text-2xl font-black tracking-[-0.03125em] text-accent-red">
                    {g.blurb.split('·')[0].trim()}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <section aria-labelledby="guides-faq" class="mt-16">
        <h2 id="guides-faq" class="font-display text-[28px] leading-[1.2] tracking-normal text-ink">
          Setting up 2FA: common questions
        </h2>
        <div class="mt-6 divide-y-2 divide-dashed divide-hairline-strong">
          {
            faqs.map(({ q, a }) => (
              <details class="group px-1 py-1">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-bold text-ink select-none marker:hidden">
                  {q}
                  <svg class="h-4 w-4 shrink-0 text-ink transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                  </svg>
                </summary>
                <p class="pb-5 text-sm font-medium text-ink">{a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <div class="cta-banner on-dark mt-10">
        <h2 class="font-display text-2xl tracking-normal text-primary">All services, one generator</h2>
        <p class="mt-2 max-w-2xl font-medium text-cream/80">
          Every guide ends in the same place: paste the key, get live codes. The generator
          implements the exact RFC 6238 standard each of these services uses.
        </p>
        <a
          href="/#generator"
          class="btn-primary mt-6 inline-flex"
        >
          Open the generator
        </a>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
