---
import GuideLayout from '../../components/GuideLayout.astro';

const title = 'How to Set Up 2FA on LinkedIn (Authenticator App)';
const description =
  'Enable two-step verification on LinkedIn with an authenticator app. Enter LinkedIn’s secret key or scan the QR code, then generate TOTP codes in your browser.';
---

<GuideLayout
  serviceName="LinkedIn"
  title={title}
  description={description}
  path="/guides/linkedin/"
  datePublished="2026-11-18"
  dateModified="2026-11-18"
  lastReviewed="2026-11-18"
  intro="LinkedIn supports authenticator apps alongside SMS, and its official instructions describe manual entry using a secret key LinkedIn provides. That matters if you work across shared machines or want a login that does not depend on a phone number."
  minutes={4}
  params={['6 digits', '30 s period', 'SHA-1']}
  ctaTitle="Your network is worth protecting"
  ctaBody="A hijacked LinkedIn account can message your entire network, damage your professional reputation, and expose recruiting conversations. Store the setup secret in your vault and keep any recovery codes separate from the device you sign in on."
  deepDive={{
    heading: "LinkedIn nuances before you enroll",
    blocks: [
      {
        title: 'The authenticator option is not always the default',
        body: 'LinkedIn has long offered SMS codes, and it still presents SMS prominently. Choose the authenticator-app path explicitly; otherwise you end up with a second factor that a SIM swap can intercept. Once the app is enrolled, you can usually remove SMS as a sign-in method while keeping a recovery route.',
      },
      {
        title: 'Company SSO can bypass LinkedIn 2FA entirely',
        body: 'If your employer uses LinkedIn’s enterprise SSO or you sign in through a connected identity provider, LinkedIn may not ask for its own second factor. That is not a gap in your setup — the identity provider is performing authentication. Check with your IT team which layer owns the login before duplicating methods.',
      },
      {
        title: 'Trusted devices and the “remember me” trade-off',
        body: 'LinkedIn can remember a device so you are not asked for a code every time. That is convenient on a personal laptop and a bad idea on a shared or public machine. Pair the convenience with a device you control, and sign out remotely if you lose access to it.',
      },
    ],
  }}
  steps={[
    {
      title: 'Open LinkedIn settings',
      body: 'Sign in at linkedin.com, click “Me” under your profile picture → “Settings & Privacy” → “Sign in & security” → “Two-step verification”.',
    },
    {
      title: 'Turn on two-step verification',
      body: 'Click “Turn on” and choose “Authenticator app” rather than phone/SMS. LinkedIn walks you into the setup flow.',
    },
    {
      title: 'Get the setup key',
      body: 'LinkedIn provides a secret key for manual entry during setup; the exact label varies. Copy it if shown. If your screen only displays a QR code, screenshot it and paste the image into the generator — the QR is decoded locally.',
    },
    {
      title: 'Generate a code',
      body: 'Paste the key into 2facounter.com and label it “LinkedIn”. The live 6-digit code refreshes every 30 seconds; no key ever leaves your browser.',
    },
    {
      title: 'Confirm and finish',
      body: 'Enter the current code in LinkedIn’s confirmation field. LinkedIn lists the authenticator as an active method. If the flow presents recovery codes, download or copy them now.',
    },
    {
      title: 'Store the key as your backup',
      body: 'Put the setup secret in your encrypted password manager. Even if you never see LinkedIn recovery codes, the saved secret lets you regenerate codes on any trusted browser — which is the real backup.',
    },
  ]}
  faqs={[
    {
      q: 'Does LinkedIn use standard TOTP codes?',
      a: 'Yes. The authenticator-app option produces standard 6-digit, 30-second TOTP codes using SHA-1. The same secret works in any compatible app or in this browser generator.',
    },
    {
      q: 'Can I use LinkedIn 2FA without SMS?',
      a: 'The authenticator-app method is independent of your phone number. LinkedIn may keep a phone number for recovery, but the daily codes come from the secret, not from a text message. Choose the app during setup rather than the SMS option.',
    },
    {
      q: 'Does 2FA slow down job applications?',
      a: 'No. It only appears at sign-in or when LinkedIn asks you to re-authenticate. Applying to jobs, messaging, and browsing within an existing session work normally.',
    },
    {
      q: 'What if I lose the device with the authenticator?',
      a: 'Use the recovery codes if LinkedIn gave you any, or paste the saved setup secret into the generator on another device. Without one of those, use LinkedIn’s account-recovery flow — which is why storing the secret at setup time matters.',
    },
  ]}
/>
