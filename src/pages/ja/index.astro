---
/* 日本語 — 翻訳版ホームページ (hreflang: ja)。index.astro と並行構成。 */
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Generator from '../../components/Generator.astro';

const title = '2FAコード生成ツール — 無料オンライン認証アプリ（TOTP）';
const description =
  '秘密鍵を貼り付けるだけでワンタイムパスワードを生成できる無料のオンライン2段階認証アプリ。TOTPコードがライブ表示され、30秒ごとに自動更新。登録もスマホも不要です。';

const homeAlternates = [
  { hreflang: 'en', href: 'https://2facounter.com/' },
  { hreflang: 'vi', href: 'https://2facounter.com/vi/' },
  { hreflang: 'zh-Hans', href: 'https://2facounter.com/zh-cn/' },
  { hreflang: 'zh-Hant', href: 'https://2facounter.com/zh-tw/' },
  { hreflang: 'es', href: 'https://2facounter.com/es/' },
  { hreflang: 'ja', href: 'https://2facounter.com/ja/' },
  { hreflang: 'fr', href: 'https://2facounter.com/fr/' },
  { hreflang: 'de', href: 'https://2facounter.com/de/' },
  { hreflang: 'pt', href: 'https://2facounter.com/pt/' },
  { hreflang: 'ko', href: 'https://2facounter.com/ko/' },
  { hreflang: 'it', href: 'https://2facounter.com/it/' },
  
  { hreflang: 'hi', href: 'https://2facounter.com/hi/' },

  { hreflang: 'ar', href: 'https://2facounter.com/ar/' },

  { hreflang: 'bn', href: 'https://2facounter.com/bn/' },

  { hreflang: 'ru', href: 'https://2facounter.com/ru/' },
{ hreflang: 'x-default', href: 'https://2facounter.com/' },
];

const faq = [
  {
    q: '2FAコードはどうやって取得するのですか？',
    a: '保護したいアカウントの設定を開き、「セキュリティ」や「ログインとセキュリティ」の中から「二段階認証」や「2段階認証（2ステップ認証）」の項目を探します。認証アプリを選び、QRコードを読み取るか、「スキャンできない場合」からセットアップキー（Base32文字列または otpauth:// URI）を表示させて、このページ上部のジェネレーターに貼り付けてください。ライブコードを入力して設定を確定したら、サービスが表示するリカバリーコードは必ず保存しておきましょう。',
  },
  {
    q: '2段階認証を有効にするにはどうすればいいですか？',
    a: '手順は4つ、所要時間はおよそ2分です。1) アカウントまたはセキュリティ設定を開き、「二段階認証」を選択する。2) 「認証アプリを使う」を選ぶ（より良い選択肢がある限り、SMSは避けましょう）。3) お使いの認証アプリでQRコードを読み取るか、セットアップキーを表示して保存する。4) ライブコードを入力して完了したら、バックアップコードをダウンロードまたは印刷します。Google、GitHub、Discord、Binance などのサービス別ガイドも公開しています。',
  },
  {
    q: '2FAの仕組みはどうなっていますか？',
    a: 'パスワードの入力後、サービスは本人確認の第二の情報を求めてきます。標準の TOTP 方式（RFC 6238）では、認証アプリが共有シークレットと現在時刻から6桁のコードを算出し、サーバー側でもまったく同じ計算を行ってこの2つを照合します。コードは30秒ごとに再生成され、有効期限が過ぎれば無価値になるため、パスワードが漏れてもそれ単独ではアカウントを開けられません。',
  },
  {
    q: '2FAは何のために使われていますか？',
    a: '他人がログインを狙うあらゆる窓口を守ります。メールとクラウド（Google、Microsoft、Apple）、銀行・証券口座、暗号資産取引所（Binance、Coinbase、Kraken）、開発者向けプラットフォーム（GitHub、AWS）、ゲーム（Steam、Discord、Twitch）、SNS（X、Instagram）など。企業では VPN、メール、管理コンソールにも使われています。サイトに「認証アプリ」の選択肢があれば、それが2FAの経路です。',
  },
  {
    q: '2FAは100%安全なのですか？',
    a: 'いいえ — 100%安全なセキュリティ対策は存在せず、誠実なガイドはそう明言しています。2FAはパスワード流出攻撃をほぼ無力化しますが、有効な30秒の間に偽サイトへ入力されたコードはフィッシングに悪用され得ますし、端末に仕込まれたマルウェアはセッションそのものを乗っ取れますし、SMSコードはSIMスワップ攻撃の餌食になることもあります。それでも、2FAが設定されたアカウントは、設定されていないアカウントよりはるかに突破が難しいのです。',
  },
  {
    q: '2FAは義務ですか？',
    a: '法律で義務化している国はありませんが、取り入れるプラットフォームは増え続けています。GitHub は2023年以降コードの投稿者に必須とし、銀行や暗号資産取引所は強制にしており、勤務先のログインで求められるのも珍しくありません。それ以外では任意ですが、強く推奨されます。とはいえ、最も価値のあるアカウント — 自分のメールアカウント — では必須として扱いましょう。受信箱を支配された人が、それ以外のすべてをリセットできてしまうからです。',
  },
  {
    q: '2FAがこれほど重要なのはなぜですか？',
    a: 'パスワードが、いつも同じ経路で破られてきたからです。数十億件もの実在するパスワードが流出事件で既に公開されており、攻撃者はそれを昼夜を問わず別のサイトに再利用します（クレデンシャルスタッフィング）。Microsoft の報告によれば、2FAは自動化されたアカウント乗っ取り攻撃の99.9%以上を防ぎます。現実に起こる脅威からメール・銀行・ゲーム・暗号資産を守れる、最も安価な強化策なのです。',
  },
  {
    q: '2FAの強度はどのくらいですか？',
    a: '第二の要素次第です。SMSコードが最も弱く、SIMスワップで電話番号を奪われればコードも受け取られてしまいます。TOTP認証コード — 30秒ごとに切り替わる種類 — は計算量的に強固です。何も送信されず、オフラインの攻撃者には導出できず、一つひとつが数秒で失効します。セキュリティキーとパスキーはフィッシング耐性があり、本来のドメインに暗号的に紐付くため、その中でも最強です。',
  },
  {
    q: 'なぜ今はどこも2FAを使うのですか？',
    a: 'パスワードだけの時代が崩壊したからです。産業規模の流出事件が数十億件の認証情報を晒し、自動化されたクレデンシャルスタッフィングでアカウント乗っ取りはほぼ無償で行えるようになりました。規制も追随しています。米国 NIST の標準では SMS 認証が非推奨とされ、EU の PSD2 は強力な顧客認証を義務付けています。大手が2FAを普通にしてしまえば、他のサービスが続くのは自然の成り行きです。',
  },
  {
    q: 'この認証ツールを使うのにスマホは必要ですか？',
    a: '必要ありません。これはブラウザで動く2FAツールです。モダンブラウザの載ったノートPC、タブレット、デスクトップならどこでも動作し、アプリとして追加すれば完全オフラインでも使えます。スマホが紛失・売却・故障・電池切れのとき、あるいは職場で持ち込みが認められていないときでも、スマホのアプリの代わりを務めます。',
  },
  {
    q: '2FA COUNTER は安全に使えますか？',
    a: 'はい。すべての計算は Web Crypto API によって、あなたのブラウザ内だけで行われます。秘密鍵がサーバーへ送信されることも、サーバーから見られることも、決してありません。ページを読み込んだ後にネットから切断しても、ジェネレーターは動き続けます。',
  },
  {
    q: 'オフラインでも使えますか？',
    a: 'もちろんです。2FA COUNTER をアプリとして追加（ホーム画面に追加／インストール）すれば、ネイティブの認証アプリのように完全オフラインで動きます。コードは秘密鍵と端末の時計から導出されるので、ネット接続は一切不要です。',
  },
  {
    q: '2FAコードが拒否されるのはなぜですか？',
    a: 'ほとんどの場合、時計のずれが原因です。TOTPコードは時刻基準なので、端末の時計がわずか30秒でもずれていればコードは無効になります。OS の時刻を自動同期に設定して（Windows なら日付と時刻の設定にある「今すぐ同期」、macOS なら「日付と時刻を自動的に設定」）、もう一度お試しください。ジェネレーターは端末が報告する時刻で計算しており、直してくれる時計を自前では持っていません。',
  },
  {
    q: 'Google Authenticator や Authy とは何が違うのですか？',
    a: 'あちらはスマホアプリ、こちらはブラウザで動く認証ツールです。アルゴリズムはまったく同じ RFC 6238 TOTP で、標準の認証アプリを受け付けるすべてのサービスと連携します。Google Authenticator 代替としての決定的な違いは、認証アプリの乗換を検討している人にもうれしく、スマホが壊れても売っても電池切れでも、アクセスを失わないことです。',
  },
  {
    q: '鍵はどこに保存されますか？',
    a: '自分のブラウザの中だけです。最後に入力した鍵と直近の「最近の鍵」リスト（最大8件）は、この端末のローカルストレージに保存されているため、ページを更新してもジェネレーターは復元され、ワンクリックで鍵を切り替えられます — 当社のサーバーには保存されません。そもそもサーバーが存在しないのですから。鍵は平文で保存されるため、このブラウザプロファイルを開ける人は誰でも読めます。プロファイルはパスワードマネージャーの金庫室のように扱ってください。リスト上の「すべて消去」（確認ダイアログ付き）、入力欄のクリア、またはブラウザデータの削除で完全に消去されます。原本のシークレットは、パスワードマネージャーにマスターコピーとして保管しておきましょう。',
  },
  {
    q: 'HOTP、8桁コード、SHA-256 系のサービスでも使えますか？',
    a: 'はい。サービスが発行する otpauth:// URI を丸ごと貼り付けば、それに含まれるすべてのパラメータが自動で反映されます — 6／7／8桁、15／30／60秒周期、SHA-1／SHA-256／SHA-512 のハッシュ、カウンタ方式の HOTP まで。鍵のみ（Base32）を貼った場合は標準のデフォルト（6桁、30秒、SHA-1）が適用されますが、ほぼすべてのサービスがこのデフォルトを使用しています。',
  },
  {
    q: '本当に無料ですか？',
    a: 'はい — アカウント登録も、プレミアムプランも、ログインもありません。これはサービスではなく、ツールです。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '2FA COUNTER',
    alternateName: ['2FA COUNTER', '2facounter', '2FA Online Authenticator', '2FA Auth Tool'],
    url: 'https://2facounter.com/ja/',
    description,
    applicationCategory: 'SecurityApplication',
    applicationSubCategory: 'Two-Factor Authentication',
    operatingSystem: 'Any (browser-based)',
    browserRequirements: 'Web Crypto API に対応したモダンブラウザ',
    softwareVersion: '2.0',
    featureList: [
      'TOTP 2FAコード生成（RFC 6238）',
      'HOTPコード生成（RFC 4226）',
      'カメラまたはスクリーンショットによるQRコード読み取り',
      'オフライン／PWA対応',
      'SHA-1、SHA-256、SHA-512ハッシュ',
      '6桁・7桁・8桁コード対応',
      '最近の鍵リスト',
      'ゼロ知識 — サーバーもアカウントもなし',
    ],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    inLanguage: ['en', 'vi', 'zh-CN', 'zh-TW', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it', 'hi', 'ar', 'bn', 'ru'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const steps = [
  {
    n: '01',
    title: '秘密鍵を入手する',
    body: 'サービスで「二段階認証 → 認証アプリ」と表示されたら、「スキャンできない場合？セットアップキーを表示」を選びます。JBSWY3DPEHPK3PXP のような Base32 文字列、または otpauth:// リンク全体が入手できます。どちらもここで使えます。',
  },
  {
    n: '02',
    title: '貼り付ける、ドロップする、スキャンする',
    body: '鍵や URI をジェネレーターに貼り付けるか、QRコードのスクリーンショットをページにドロップするか、カメラで読み取ります。すべて端末上でデコードされ、何もアップロードされません。',
  },
  {
    n: '03',
    title: 'ライブコードをコピー',
    body: '数秒で新しいトークンが表示され、端末の時計に同期されます。コピーしてログインを完了しましょう。コードは30秒ごとに自動更新されます。',
  },
];

const features = [
  {
    title: 'ひとつの入力欄、ひとつのライブトークン',
    body: '秘密鍵または otpauth:// リンク全体を貼り付ければ、対応するコードがすぐにカウントダウンを始めます — セットアップも、フォームも、「アカウント追加」の儀式もありません。',
  },
  {
    title: 'スクリーンショットを貼れば鍵になる',
    body: 'Ctrl+V でQRコードの画像を貼る、画像ファイルをドロップする、ウェブカメラでスキャンする。インポートの入口は3つ、鍵が漏れる出口はゼロです。',
  },
  {
    title: 'パラメータを全面的にサポート、自動判別',
    body: '鍵だけなら標準のデフォルト、otpauth:// URI 全文なら含まれるパラメータをすべて反映 — 6／7／8桁、15／30／60秒周期、SHA-1／256／512、カウンタ方式の HOTP まで。',
  },
  {
    title: '更新に強く、切り替えも一行',
    body: 'ページを開き直しても、最後の鍵がすでにそこにあります。「最近の鍵」リストならワンクリックで鍵を切り替えられます — 復元元はこの端末のローカルストレージだけで、サーバーからは決して。',
  },
  {
    title: 'インストールも登録も不要',
    body: 'スマホアプリも、アカウントも、同期の課金も、トラッキングもありません。ブラウザを開けられる人なら、コードを作れます。',
  },
  {
    title: 'オフライン対応・インストール可能',
    body: 'タブを閉じても、通信を絶っても動きます。それは文字通りの話です。そして PWA としては、ネイティブアプリのようにドックやホーム画面にインストールできます。',
    v: 'dark',
