const title = '2FAコードの取得方法：ステップバイステップガイド（TOTP）';
const description =
  '2FAコードの取得方法を3ステップで解説：セットアップキーを表示させ、オンラインのTOTPジェネレーターに貼り付け、ライブのワンタイムパスワードをコピーして入力する手順と、コードが拒否されたときの対処法。';

const faq = [
  {
    q: 'セットアップキーはどこにありますか？',
    a: '認証アプリ用のQRコードをサービスが表示するのと同じ画面にあります。「スキャンできない場合」「コードを手動で入力」「セットアップキーを表示」といったリンクを探してください。リンクから Base32 文字列（または otpauth:// URI 全体）が表示されます — どちらの形式もジェネレーターで使えます。',
  },
  {
    q: 'コードが拒否されます — どうすればいいですか？',
    a: 'ほとんどの場合、時計のずれが原因です。TOTP は時刻基準なので、端末の時計がわずか30秒でもずれていれば、無効なコードが生成されてしまいます。OS の時刻を自動同期に設定してから、もう一度お試しください。',
  },
  {
    q: 'スマホのアプリが生成するコードと同じですか？',
    a: '同じです。どの認証アプリ — Google Authenticator、Authy、Microsoft Authenticator、あるいはこのブラウザツール — も、同じシークレットと同じ時計から、同じ RFC 6238 TOTP コードを計算します。互換があります。',
  },
  {
    q: 'リカバリーコードは今も必要ですか？',
    a: 'はい。このツールとは別の場所に、オフラインで保管してください。シークレットキーを保存した端末へのアクセスを失ったとき、アカウントに戻る道はリカバリーコードです。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/ja/' },
      { '@type': 'ListItem', position: 2, name: '2FAコードの取得方法', item: 'https://2facounter.com/ja/how-to-get-2fa-code/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'オンライン TOTP ジェネレーターで2FAコードを取得する方法',
    totalTime: 'PT3M',
    step: [
      { '@type': 'HowToStep', position: 1, name: '2FAをオンにしてセットアップキーを表示させる', text: 'サービスのセキュリティ設定を開き、認証アプリの選択肢を選んで、QRコードが読み取れないときに備えてセットアップキーを表示させます。' },
      { '@type': 'HowToStep', position: 2, name: '鍵をジェネレーターに貼り付ける', text: 'Base32 文字列または otpauth:// URI を、2FA COUNTER ホームページのジェネレーターに貼り付けます。すべての計算はブラウザ内でローカルに行われます。' },
      { '@type': 'HowToStep', position: 3, name: 'ライブコードをコピーして確定する', text: '6桁のコードを、30秒の有効期間のうちにサービスの確認画面に入力して設定を確定します — 以後のサインインも毎回同じ流れで行います。' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const alternates = [
  { hreflang: 'en', href: 'https://2facounter.com/how-to-get-2fa-code/' },
