---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReviewByline from '../components/ReviewByline.astro';
import SourcesList from '../components/SourcesList.astro';

const title = 'Authy Alternatives: What to Use Instead, and How to Switch';
const description =
  'Twilio killed the Authy desktop app in August 2024 and there is no export. Your options, what each costs, and how to switch without a lockout.';

const sources = [
  {
    label: 'Authy Help Center',
    href: 'https://authy.com/help/',
    kind: 'official' as const,
  },
  {
    label: 'Twilio Docs — Authy: 2FA and Passwordless Login',
    href: 'https://www.twilio.com/docs/authy',
    kind: 'official' as const,
  },
  {
    label: 'BleepingComputer — Twilio kills off Authy for desktop, forcibly logs out all users (1 Aug 2024)',
    href: 'https://www.bleepingcomputer.com/news/security/twilio-kills-off-authy-for-desktop-forcibly-logs-out-all-users/',
    kind: 'independent' as const,
  },
  {
    label: 'BleepingComputer — Twilio will ditch its Authy desktop 2FA app in August, goes mobile only (8 Jan 2024)',
    href: 'https://www.bleepingcomputer.com/news/security/twilio-will-ditch-its-authy-desktop-2fa-app-in-august-goes-mobile-only/',
    kind: 'independent' as const,
  },
  {
    label: 'The Verge — Twilio alerts Authy users that “threat actors” have their phone numbers (3 Jul 2024)',
    href: 'https://www.theverge.com/2024/7/3/24191791/twilio-authy-2fa-app-phone-numbers-hack-data-breach',
    kind: 'independent' as const,
  },
  {
    label: 'Wired — Why the Twilio Breach Cuts So Deep (26 Aug 2022)',
    href: 'https://www.wired.com/story/twilio-breach-phishing-supply-chain-attacks/',
    kind: 'independent' as const,
  },
  {
    label: 'RFC 6238 — TOTP: Time-Based One-Time Password Algorithm',
    href: 'https://www.rfc-editor.org/rfc/rfc6238',
    kind: 'independent' as const,
  },
];

const faqs = [
  {
    q: 'Is Authy shutting down completely?',
    a: 'We found no announcement of a full shutdown. What ended was the desktop apps, on 1 August 2024. The iOS and Android apps remain available and Twilio still publishes Authy API documentation. Treat the product as phone-only rather than dead — but a phone-only Authy is a smaller thing than the app most people installed, and its exit cost has not changed.',
  },
  {
    q: 'What exactly happened to Authy Desktop?',
    a: 'Twilio announced in January 2024 that the Windows, macOS and Linux apps would reach end of life on 19 March 2024, then let them keep running with an end-of-life warning. On 1 August 2024 it logged every desktop user out and stopped them signing back in with their phone number. Version 3.0 had been the final desktop release. Users who had never synced to a phone lost their token list outright.',
  },
  {
    q: 'Can I export my tokens from Authy?',
    a: 'No. Authy has never shipped an export feature, and retiring the desktop client did not add one. Every migration means disabling and re-enrolling 2FA on each service, one account at a time, using the setup key the service shows you. Anything that offers to “export your Authy secrets” is asking for credentials it should not have — treat it as phishing.',
  },
  {
    q: 'What is the best Authy alternative?',
    a: 'There is no single answer, because the alternatives are different shapes. If you want one app with tap-to-restore, a different phone app with encrypted backup (Aegis, 2FAS, Ente Auth) is the closest like-for-like swap. If you want one vault for passwords and codes, your password manager is simpler. If what you actually lost was the desktop client, a browser generator is the only category that gives it back — no install, no account, no phone number.',
  },
  {
    q: 'Will switching break my accounts?',
    a: 'It can, and the 2024 shutdown showed how. Users who assumed their desktop tokens were mirrored on a phone found that some had never synchronised correctly, leaving accounts unreachable. The defence is procedural: keep Authy installed until every account has been re-enrolled and the new code accepted, do the whole swap in one sitting, and save the recovery codes before you close the screen.',
  },
  {
    q: 'Is a browser generator as safe as Authy?',
    a: 'The codes are identical — both compute RFC 6238 HMAC from the same Base32 secret, so every service accepts either. What differs is where the secret lives and who can reach it. A phone app keeps it behind a device lock; a browser generator keeps it nowhere, computing from text you paste and holding nothing after the page closes. That is stronger against a breached vendor and weaker against a compromised desktop, which is why the vault copy matters more than the tool.',
  },
  {
    q: 'Do I need a phone number to use a browser generator?',
    a: 'No. Authy registration requires one, and that number is the identifier the account hangs on — the part a carrier controls rather than you. In 2024 an unsecured Authy API let attackers check whether a number had an Authy account, and roughly 33 million numbers were profiled and leaked. A browser generator has no account, no number and nothing to reset: the Base32 secret is the factor.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: 'https://2facounter.com/totp-vs-authy/',
    datePublished: '2026-11-09',
    dateModified: '2026-11-23',
    author: { '@type': 'Organization', name: '2FA COUNTER', url: 'https://2facounter.com' },
    publisher: {
      '@type': 'Organization',
      name: '2FA COUNTER',
      url: 'https://2facounter.com',
      logo: { '@type': 'ImageObject', url: 'https://2facounter.com/web-app-manifest-512x512.png' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://2facounter.com/totp-vs-authy/' },
    citation: sources.map((s) => s.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
      { '@type': 'ListItem', position: 2, name: 'Authy alternatives', item: 'https://2facounter.com/totp-vs-authy/' },
    ],
  },
];
---

<Layout title={title} description={description} path="/totp-vs-authy/" jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <article class="mx-auto max-w-[820px] px-4 py-16 sm:px-6 lg:py-24">
      <p class="section-label">Learn</p>
      <h1 class="mt-3 font-display text-4xl tracking-normal text-ink sm:text-5xl">
        Authy alternatives: what to use instead, and how to switch
      </h1>
      <p class="mt-5 max-w-2xl text-lg font-medium text-ink">
        Authy is still a working authenticator on a phone. What changed is the exit: the desktop apps
        were forcibly logged out in August 2024, there is still no export feature, and the account
        hangs on a phone number. Here is what actually happened, which alternatives exist, and the
        order to switch in that does not cost you an account.
      </p>

      <nav aria-label="On this page" class="mt-10 rounded-xl border-2 border-ink bg-cream p-6" style="box-shadow: var(--shadow-card)">
        <p class="font-mono text-[13px] font-bold tracking-wide text-ink uppercase">On this page</p>
        <ul class="mt-3 space-y-2 text-sm font-medium text-ink">
          <li><a class="link" href="#short">The short answer</a></li>
          <li><a class="link" href="#timeline">What happened to Authy Desktop</a></li>
          <li><a class="link" href="#exit">The exit problem</a></li>
          <li><a class="link" href="#options">Four realistic options</a></li>
          <li><a class="link" href="#migrate">How to switch without a lockout</a></li>
          <li><a class="link" href="#stay">When Authy is still the right call</a></li>
          <li><a class="link" href="#faq">FAQ</a></li>
        </ul>
      </nav>

      <p class="mt-6 max-w-2xl font-mono text-[13px] text-ink/90">
        Claims checked against Authy's help centre, Twilio's documentation and contemporaneous
        reporting on the 2024 shutdown · last reviewed 23 November 2026 ·{' '}
        <a href="/methodology/" class="link">how we review</a>
      </p>
      <ReviewByline />
      <SourcesList sources={sources} />

      <div class="rich-text mt-12">
        <h2 id="short">The short answer</h2>
        <p>
          If you want what Authy used to be — one app, effortless restore on a new phone — you are
          not getting the desktop half back from Authy, because the desktop client is gone and there
          is no export to move what is left. The realistic replacements are three, and they are
          different shapes rather than different brands:
        </p>
        <ul>
          <li>
            <strong>Another phone app with encrypted backup</strong> — keeps the tap-to-restore
            convenience. Still a phone.
          </li>
          <li>
            <strong>Your password manager</strong> — the secret sits next to the password it belongs
            to, so one vault covers both. Two factors in one place.
          </li>
          <li>
            <strong>A browser generator</strong> — no install, no account, no phone number, and the
            desktop story comes back. You store the secret yourself.
          </li>
        </ul>
        <p>
          Whichever you pick, the switch is the same job: one account at a time, in one sitting, with
          the old token kept alive until the new one has produced a code the service accepted.
        </p>

        <h2 id="timeline">What actually happened to Authy Desktop</h2>
        <p>
          Most write-ups get the date wrong, so here it is with the announcement and the shutdown
          separated:
        </p>
        <ul>
          <li>
            <strong>January 2024</strong> — Twilio announced that the desktop apps for Windows, macOS
            and Linux would reach end of life on <strong>19 March 2024</strong>, with discontinuation
            to follow.
          </li>
          <li>
            <strong>March came and went.</strong> The apps kept working and showed an end-of-life
            warning telling people to move to mobile. Version 3.0 was the final desktop release.
          </li>
          <li>
            <strong>1 August 2024</strong> — Twilio forcibly logged every desktop user out and stopped
            them signing back in with their phone number. That is the date the client actually died.
          </li>
          <li>
            <strong>The damage afterwards.</strong> Users who had never synced to a phone found their
            token list gone. Users who <em>had</em> synced discovered that some tokens had never
            synchronised correctly — accounts they could no longer reach, despite doing the sensible
            thing.
          </li>
        </ul>
        <p>
          That last point is the real argument, and it is not about TOTP being unreliable. It is that
          an app you installed on your own machine can be switched off remotely, on a date you did not
          choose, by the company that shipped it — and the backup you were told to trust may be
          incomplete in exactly the way you cannot check until you need it.
        </p>

        <h2 id="exit">The exit problem</h2>
        <p>
          Two things make leaving Authy harder than leaving most authenticators, and neither is a bug:
        </p>
        <p>
          <strong>There is no export.</strong> Authy has never shipped a way to export secrets, and
          retiring the desktop client did not add one. Every migration is per-service: you disable 2FA
          on each account and re-enrol it against the new tool. There is no bulk path, and any tool
          claiming otherwise is asking for credentials it should not have.
        </p>
        <p>
          <strong>The support surface has shrunk.</strong> Authy's consumer help centre now lists four
          topics — resetting an account, changing your phone number, deleting your account, and
          contacting support. There is no documentation of the app itself. That tells you where a
          consumer product sits inside a communications platform company.
        </p>
        <p>
          Then there is the identifier. Authy registration requires a phone number, and that number is
          what the account hangs on — the one part of a 2FA setup a carrier controls instead of you.
          Two documented incidents show what that identity is worth to an attacker:
        </p>
        <ul>
          <li>
            <strong>June–July 2024.</strong> An unsecured Authy API let anyone check whether a phone
            number had an Authy account. Attackers fed it numbers in bulk, built profiles of roughly
            <strong>33 million</strong> phone numbers, and leaked them on a hacking forum. Twilio
            secured the API and shipped an updated mobile app.
          </li>
          <li>
            <strong>August 2022.</strong> Attackers who phished Twilio employees reached Authy
            accounts and linked some to devices they controlled.
          </li>
        </ul>
        <p>
          Neither incident handed over the secrets themselves — Authy encrypts backups. Both show what
          the phone number is for: it is the handle the account is recovered through, and recovery is
          the step attackers actually need.
        </p>

        <h2 id="options">Four realistic options</h2>
        <p>
          These are architectures, not a ranking. The right one depends on which part of Authy you
          actually used.
        </p>

        <h3>A different phone app with encrypted backup</h3>
        <p>
          Examples of the category: Aegis (Android), 2FAS, Ente Auth. <strong>What you keep:</strong>{' '}
          tap-to-restore, a familiar scanner, universal compatibility with every service.{' '}
          <strong>What it costs:</strong> it is still a phone, and cross-device restore depends on
          that app's own backup service — a second vendor holding, or syncing, your backup.{' '}
          <strong>Pick it if</strong> your only real complaint is that Authy's desktop client died.
        </p>

        <h3>Your password manager</h3>
        <p>
          Examples of the category: Bitwarden, 1Password, KeePassXC. <strong>What you get:</strong> the
          TOTP secret lives in the same vault as the password, so one backup covers both and there is
          no second app to lose. <strong>What it costs:</strong> whoever opens your vault gets both
          factors, which stops the second factor being independent. Plenty of people accept that for
          forums and shops and refuse it for email and banking. <strong>Pick it if</strong> you are
          already disciplined about vault hygiene.
        </p>

        <h3>A browser generator</h3>
        <p>
          This site. <strong>What you get:</strong> no install, no account, no phone number, and the
          code computes on whatever machine you are actually sitting at — including a locked-down work
          laptop you cannot install software on. <strong>What it costs:</strong> you store the secret
          yourself; there is no restore fairy. A browser tab is also a weaker boundary than a
          dedicated app on a phone you carry. <strong>Pick it if</strong> what you lost was the
          desktop client, or you want the secret as data rather than as an account.
        </p>

        <h3>Staying on Authy</h3>
        <p>
          Genuinely reasonable for some people: if effortless device migration matters more than
          anything else, your accounts are not the kind targeted by phone-number resets, and you are
          content with a phone-only product. The trade-off is fixed, though — the desktop client is
          not coming back, and the exit cost gets paid at the worst possible moment instead of on your
          schedule.
        </p>
        <p>
          <em>
            The apps above are named as examples of each architecture, not as tested reviews. We have
            not audited their code; the TOTP mechanics they share are the same RFC 6238 standard cited
            in the sources for this page.
          </em>
        </p>

        <h2 id="migrate">How to switch without a lockout</h2>
        <p>
          The constraint that catches people: turning 2FA off requires the old code. So the migration
          order matters more than the destination.
        </p>
        <ol class="list-decimal">
          <li>
            <strong>Leave Authy installed.</strong> Every service will ask you to prove you still hold
            the old factor.
          </li>
          <li>
            <strong>Start with one low-stakes account.</strong> Learn the flow where a mistake costs
            nothing.
          </li>
          <li>
            <strong>Disable 2FA, or choose “set up a different authenticator”</strong> if the service
            offers it — that path skips the gap where the account is unprotected.
          </li>
          <li>
            <strong>Take the manual key, not the QR.</strong> “Can’t scan?” or “enter key manually”
            reveals the Base32 string. Store it in your vault under the account name.
          </li>
          <li>
            <strong>Paste it into the generator</strong> and confirm the code the service accepts —
            a green tick, not an assumption.
          </li>
          <li>
            <strong>Save the new recovery codes</strong> before you close the screen. Some services
            issue them only once.
          </li>
          <li>
            <strong>Only then remove the token from Authy.</strong> Repeat for the next account.
          </li>
        </ol>
        <p>Two rules, both learned from the 2024 shutdown:</p>
        <ul>
          <li>
            <strong>Never leave 2FA off overnight.</strong> Do the whole swap in one sitting. The
            window between disabling and re-enrolling is the only moment the account has one factor.
          </li>
          <li>
            <strong>Keep the old token until the new one is proven.</strong> A code that has not been
            accepted by the service is not a working replacement.
          </li>
        </ul>
        <p>
          Work through everything before you delete anything, and treat email and banking last — with
          recovery codes written down rather than only on screen. Email is the reset channel for
          almost everything else, so it is the account you least want mid-migration.
        </p>

        <h2 id="stay">When Authy is still the right call</h2>
        <p>
          If your phone is the only device you sign in from, restore-on-new-hardware is worth more to
          you than portability, and the accounts behind it are not reachable by a phone-number reset,
          then Authy still does its one job. The honest summary is not that Authy is bad — it is that
          it is a phone-only product with no exit, and both of those facts were choices.
        </p>
        <p>
          If you want to keep the phone habit <em>and</em> get the desktop back, running both is a
          legitimate end state: Authy for phone sign-ins, a saved setup key and a browser generator for
          the desktop. The thing that keeps every option open is the same in every case —{' '}
          <a href="/authenticator-cloud-sync/">the secret as text in your own vault</a>, not as an
          object inside a vendor's account.
        </p>
      </div>

      <nav aria-label="Related reading" class="mt-14 border-t-2 border-dashed border-hairline-strong pt-8">
        <h2 class="font-display text-[24px] leading-[1.2] tracking-normal text-ink">Related reading</h2>
        <ul class="mt-4 space-y-1.5">
          <li><a class="link text-sm font-semibold" href="/totp-vs-passkeys/">TOTP vs passkeys: which second factor belongs where</a></li>
          <li><a class="link text-sm font-semibold" href="/authenticator-cloud-sync/">What “cloud sync” really does to your 2FA secrets</a></li>
          <li><a class="link text-sm font-semibold" href="/how-to-get-2fa-code/">How to get a 2FA code, step by step</a></li>
          <li><a class="link text-sm font-semibold" href="/methodology/">How we review and source these pages</a></li>
        </ul>
      </nav>

      <h2 id="faq" class="mt-16 font-display text-[28px] leading-[1.2] tracking-normal text-ink">FAQ</h2>
      <div class="mt-6 divide-y-2 divide-dashed divide-hairline-strong">
        {
          faqs.map(({ q, a }) => (
            <details class="group px-1 py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-bold text-ink select-none marker:hidden">
                {q}
                <svg class="h-4 w-4 shrink-0 text-ink transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                </svg>
              </summary>
              <p class="pb-5 text-sm font-medium text-ink">{a}</p>
            </details>
          ))
        }
      </div>

      <div class="cta-banner on-dark mt-12">
        <h2 class="font-display text-2xl tracking-normal text-primary">The desktop story, back</h2>
        <p class="mt-2 max-w-2xl font-medium text-cream/80">
          Paste a secret from your vault, get the live code — no account, no phone number, no client
          to deprecate. Works offline once installed.
        </p>
        <a href="/#generator" class="btn-primary mt-5">Open the generator</a>
      </div>
    </article>
  </main>
  <SiteFooter />
</Layout>
