---
/* Tiếng Việt — homepage dịch (hreflang: vi). Cấu trúc song song với
   index.astro; văn bản đã được biên tập lại và rà lỗi dịch đợt 1 (2026-11-09). */
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Generator from '../../components/Generator.astro';

const title = 'Trình tạo mã 2FA trực tuyến — mã xác thực 2FA miễn phí (TOTP)';
const description =
  'Tạo mã 2FA trực tuyến với trình xác thực miễn phí. Nhập khóa bí mật để nhận mã TOTP tự động làm mới mỗi 30 giây. Không cần đăng ký.';

const homeAlternates = [
  { hreflang: 'en', href: 'https://2facounter.com/' },
  { hreflang: 'vi', href: 'https://2facounter.com/vi/' },
  { hreflang: 'zh-Hans', href: 'https://2facounter.com/zh-cn/' },
  { hreflang: 'zh-Hant', href: 'https://2facounter.com/zh-tw/' },
  { hreflang: 'es', href: 'https://2facounter.com/es/' },
  { hreflang: 'ja', href: 'https://2facounter.com/ja/' },
  { hreflang: 'fr', href: 'https://2facounter.com/fr/' },
  { hreflang: 'de', href: 'https://2facounter.com/de/' },
  { hreflang: 'pt', href: 'https://2facounter.com/pt/' },
  { hreflang: 'ko', href: 'https://2facounter.com/ko/' },
  { hreflang: 'it', href: 'https://2facounter.com/it/' },
  { hreflang: 'x-default', href: 'https://2facounter.com/' },
];

const faq = [
  {
    q: 'Làm cách nào để lấy mã 2FA cho tài khoản?',
    a: 'Bật xác thực hai yếu tố trên dịch vụ bạn muốn bảo vệ và chọn tùy chọn “ứng dụng xác thực”. Nếu hiện mã QR, hãy tìm liên kết “không thể quét?” để hiện khóa thiết lập (chuỗi Base32 hoặc URI otpauth://). Dán khóa đó vào trình tạo phía trên — mã 2FA sẽ xuất hiện ngay và tự làm mới mỗi 30 giây.',
  },
  {
    q: 'Tôi có cần điện thoại để dùng công cụ này không?',
    a: 'Không. Đây là công cụ 2FA chạy trên trình duyệt: hoạt động trên máy tính, laptop hoặc máy tính bảng có trình duyệt hiện đại, kể cả khi không có internet sau khi cài đặt. Công cụ thay thế ứng dụng trên điện thoại khi điện thoại bị mất, bán, hư hỏng hoặc hết pin.',
  },
  {
    q: 'Trình xác thực này có an toàn không?',
    a: 'Có. Mọi phép tính diễn ra ngay trong trình duyệt của bạn bằng Web Crypto API. Khóa bí mật không bao giờ được gửi đến — hay được máy chủ nào nhìn thấy. Bạn có thể tải trang, ngắt kết nối mạng và trình tạo vẫn chạy bình thường.',
  },
  {
    q: 'Tại sao mã 2FA của tôi bị từ chối?',
    a: 'Hầu như luôn do lệch đồng hồ. Mã TOTP dựa trên thời gian, nên nếu đồng hồ thiết bị lệch nửa phút thì mã sẽ không hợp lệ. Hãy đồng bộ thời gian tự động (Windows “Sync now”, macOS “Set date & time automatically”) rồi thử lại. Trình tạo tính mã theo thời gian máy bạn báo — nó không có đồng hồ riêng để sửa.',
  },
  {
    q: 'Khóa của tôi được lưu ở đâu?',
    a: 'Chỉ trong trình duyệt của bạn. Khóa cuối cùng và danh sách “khóa gần đây” (tối đa 8) được giữ trong localStorage của thiết bị để trang chịu được khi làm mới — không bao giờ lưu trên máy chủ. Khóa lưu dạng văn bản thuần: ai mở được trình duyệt này đều đọc được, hãy coi hồ sơ trình duyệt như két mật khẩu. Nút “Clear all” xóa sạch chỉ với một cú bấm; giữ bản gốc trong trình quản lý mật khẩu.',
  },
  {
    q: 'Công cụ này có thực sự miễn phí?',
    a: 'Có — không tài khoản, không gói cao cấp, không đăng nhập. Đây là một công cụ, không phải một dịch vụ.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '2FA COUNTER',
    url: 'https://2facounter.com/vi/',
    description,
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Any (browser-based)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const steps = [
  {
    n: '01',
    title: 'Lấy khóa bí mật',
    body: 'Khi dịch vụ hiện “xác thực hai yếu tố → ứng dụng xác thực”, chọn “không thể quét? hiện khóa thiết lập”. Bạn nhận được chuỗi Base32 kiểu JBSWY3DPEHPK3PXP — hoặc cả liên kết otpauth://. Cả hai đều dùng được ở đây.',
  },
  {
    n: '02',
    title: 'Dán, kéo thả hoặc quét',
    body: 'Dán khóa hoặc URI vào trình tạo, kéo thả ảnh chụp mã QR, hoặc quét bằng camera. Tất cả được giải mã trên thiết bị của bạn — không có gì được tải lên.',
  },
  {
    n: '03',
    title: 'Sao chép mã trực tiếp',
    body: 'Một mã mới xuất hiện trong vài giây, theo đúng đồng hồ thiết bị. Nhấn sao chép và hoàn tất đăng nhập. Mã tự động làm mới sau mỗi 30 giây.',
  },
];

const features = [
  {
    title: 'Một ô nhập, một mã trực tiếp',
    body: 'Dán khóa bí mật hoặc cả liên kết otpauth://, mã tương ứng bắt đầu đếm ngược ngay — không thiết lập, không biểu mẫu.',
  },
  {
    title: 'Dán ảnh chụp, nhận khóa',
    body: 'Ctrl+V ảnh mã QR, kéo thả tệp ảnh, hoặc quét bằng webcam. Ba cách nhập, không lối nào cho khóa của bạn rò rỉ.',
  },
  {
    title: 'Hỗ trợ đầy đủ tham số, tự nhận diện',
    body: 'Khóa đơn dùng mặc định chuẩn; URI otpauth:// đầy đủ áp dụng mọi tham số: 6/7/8 chữ số, chu kỳ 15/30/60 giây, SHA-1/256/512, kể cả HOTP theo bộ đếm.',
  },
  {
    title: 'Chịu được làm mới trang — và chuyển đổi nhanh',
    body: 'Mở lại trang, khóa cuối cùng đã sẵn sàng. Danh sách khóa gần đây cho bạn đổi qua đổi lại chỉ bằng một cú nhấp — khôi phục từ localStorage của thiết bị.',
  },
  {
    title: 'Không cài đặt, không đăng ký',
    body: 'Không ứng dụng điện thoại, không tài khoản, không phí. Mở trình duyệt là tạo được mã.',
  },
  {
    title: 'Hoạt động ngoại tuyến & cài được',
    body: 'Chạy khi mạng bị tắt hoàn toàn. Và với tư cách PWA, nó cài vào dock hoặc màn hình chính như ứng dụng thật.',
  },
];

const services = [
  'Discord', 'GitHub', 'Steam', 'Binance', 'Google', 'X / Twitter',
  'AWS', 'Coinbase', 'Kraken', 'Twitch', 'Microsoft', 'Proton Mail',
];
---

<Layout title={title} description={description} path="/vi/" lang="vi" jsonLd={jsonLd} alternates={homeAlternates}>
  <SiteHeader
    links={[
      { href: '/vi/#how-it-works', label: 'Cách hoạt động' },
      { href: '/vi/#features', label: 'Tính năng' },
      { href: '/vi/#faq', label: 'Hỏi đáp' },
      { href: '/guides/', label: 'Hướng dẫn' },
      { href: '/privacy/', label: 'Quyền riêng tư' },
    ]}
    cta="Tạo mã ngay"
  />

  <main id="main">
    <section aria-label="Trình tạo mã 2FA trực tiếp">
      <div class="mx-auto max-w-[1200px] px-4 pt-10 pb-4 sm:px-6 sm:pt-16 xl:px-0">
        <Generator />
      </div>

      <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-4 pt-14 pb-12 sm:px-6 sm:pt-20 lg:grid-cols-[7fr_5fr] lg:pt-24 xl:px-0">
        <div>
          <span class="badge-eyebrow -rotate-1">100% chạy trên máy của bạn · không lưu trữ</span>
          <h1 class="mt-6 max-w-[11em] font-display text-display-xl tracking-normal text-ink lg:text-display-xxl">
            Trình tạo mã 2FA trực tiếp
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-[1.5] font-medium text-ink lg:text-xl">
            Dán khóa bí mật, nhận mã 6 chữ số ngay lập tức. Một công cụ nhanh, miễn phí, riêng tư
            thay cho Google Authenticator hay Microsoft Authenticator — cho những lúc điện thoại
            mất, hỏng hoặc hết pin.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#generator" class="btn-primary">
              Tạo mã đầu tiên của bạn
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
            <a href="#how-it-works" class="btn-secondary">Cách hoạt động</a>
          </div>
          <p class="mt-5 font-mono text-label text-ink">Không cần ứng dụng. Không tài khoản. Khóa của bạn không rời khỏi thiết bị.</p>
        </div>
        <!-- Code-window artifact: giữ nguyên phần mã (code là tiếng Anh) -->
        <div class="min-w-0 overflow-hidden rounded-xl border-4 border-ink bg-cream" style="box-shadow: var(--shadow-card)">
          <div class="flex items-center gap-2 border-b-2 border-dashed border-hairline-strong bg-ink px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-accent-red"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-canvas"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-primary"></span>
            <span class="ml-2 font-mono text-xs text-cream">otp.rfc-6238.js</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-relaxed"><code>
<span class="text-muted">// The whole tool. No servers involved.</span>
<span class="font-bold text-accent-blue">const</span> <span class="text-ink">step</span> = Math.<span class="text-ink">floor</span>(Date.<span class="text-ink">now</span>() / 1000 / 30);

<span class="font-bold text-accent-blue">const</span> <span class="text-ink">key</span> = <span class="font-bold text-accent-blue">await</span> crypto.subtle.<span class="text-ink">importKey</span>(
  'raw', <span class="text-ink">base32</span>(secret), &#123; name: 'HMAC', hash: 'SHA-1' &#125;);

<span class="font-bold text-accent-blue">const</span> <span class="text-ink">mac</span> = <span class="font-bold text-accent-blue">new</span> <span class="text-ink">Uint8Array</span>(
  <span class="font-bold text-accent-blue">await</span> crypto.subtle.<span class="text-ink">sign</span>('HMAC', key, <span class="text-ink">u64</span>(step)));

<span class="font-bold text-accent-blue">const</span> <span class="text-ink">o</span> = mac[19] &amp; 15;
<span class="font-bold text-accent-blue">const</span> <span class="text-ink">code</span> = ((mac[o] &amp; 0x7f) << 24 | mac[o+1] << 16
  | mac[o+2] << 8 | mac[o+3]) % <span class="text-ink">1e6</span>;
<span class="text-ink">code</span>.<span class="text-ink">toString</span>().<span class="text-ink">padStart</span>(6, '0'); <span class="text-muted">// ← your 2FA code</span>
</code></pre>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 xl:px-0" aria-hidden="true">
      <hr class="border-t-2 border-dashed border-ink/40" />
    </div>

    <section aria-label="Số liệu bảo mật">
      <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-4 py-16 text-center sm:grid-cols-3 sm:px-6 lg:py-20 xl:px-0">
        <div>
          <p class="font-numeric text-5xl font-black tracking-[-0.03125em] text-ink lg:text-[56px]">0</p>
          <p class="mt-2 text-sm font-medium text-ink">khóa được lưu phía chúng tôi — không có máy chủ để lưu</p>
        </div>
        <div>
          <p class="font-numeric text-5xl font-black tracking-[-0.03125em] text-ink lg:text-[56px]">100%</p>
          <p class="mt-2 text-sm font-medium text-ink">phép tính diễn ra trên thiết bị của bạn, qua Web Crypto</p>
        </div>
        <div>
          <p class="font-numeric text-5xl font-black tracking-[-0.03125em] text-ink lg:text-[56px]">6238</p>
          <p class="mt-2 text-sm font-medium text-ink">chuẩn RFC được triển khai — tương thích mọi ứng dụng xác thực</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="scroll-mt-20" aria-labelledby="how-title">
      <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 lg:py-24 xl:px-0">
        <div class="grid items-start gap-12 lg:grid-cols-[5fr_7fr]">
          <div>
            <p class="section-label">Cách hoạt động</p>
            <h2 id="how-title" class="mt-3 font-display text-3xl tracking-normal text-ink sm:text-4xl lg:text-section-display">
              Ba bước để có mã 2FA trực tiếp — không cần điện thoại.
            </h2>
            <p class="mt-5 text-lg font-medium text-ink">
              Xác thực hai yếu tố (2FA) thêm ổ khóa thứ hai cho tài khoản: một mã thay đổi mỗi
              30 giây, được sinh từ khóa bí mật dùng chung và thời gian hiện tại — tiêu chuẩn
              TOTP, RFC 6238. Trang này chính là ổ khóa thứ hai đó. Trình duyệt của bạn chạy cùng
              một phép tính với trang web bạn đang đăng nhập.
            </p>
            <p class="mt-4 font-medium text-ink">
              Vì khóa bí mật là thứ quan trọng duy nhất, bạn có thể giữ nó trong trình quản lý
              mật khẩu mã hóa và tạo lại mã ở bất kỳ đâu — laptop, hồ sơ trình duyệt thứ hai,
              máy đi công tác, kể cả khi không có mạng.
            </p>
            <p class="mt-4 text-sm font-medium text-ink">
              Muốn biết chi tiết? Đọc bài giải thích:{" "}
              <a href="/what-is-2fa/" class="link">What is 2FA? How TOTP works</a>
            </p>
            <a href="#generator" class="btn-primary mt-8">Thử ngay</a>
          </div>
          <ol class="grid gap-6 sm:grid-cols-3">
            {steps.map((s) => (
              <li class="relative flex flex-col rounded-xs border-2 border-ink bg-cream p-6 pt-7" style="box-shadow: var(--shadow-ticket)">
                <span class="absolute inset-x-3 top-1.5 border-t-2 border-dashed border-hairline-strong" aria-hidden="true"></span>
                <span class="font-numeric text-3xl font-black tracking-[-0.03125em] text-accent-red">{s.n}</span>
                <h3 class="mt-3 text-lg font-bold text-ink">{s.title}</h3>
                <p class="mt-2 text-sm font-medium text-ink">{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="features" class="scroll-mt-20" aria-labelledby="features-title">
      <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 lg:py-24 xl:px-0">
        <div class="mb-12 max-w-2xl">
          <p class="section-label">Tính năng</p>
          <h2 id="features-title" class="mt-3 font-display text-3xl tracking-normal text-ink sm:text-4xl lg:text-section-display">
            Mọi thứ một ứng dụng 2FA làm được — và tốt hơn ở nhiều điểm
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <article
              class:list={[
                'p-6 sm:p-8',
                f.v === 'dark'
                  ? 'on-dark rounded-xl border-4 border-ink bg-ink text-cream'
                  : 'rounded-xl border-2 border-ink bg-cream',
              ]}
              style={f.v === 'dark' ? 'box-shadow: var(--shadow-card)' : undefined}
            >
              <h3 class:list={['text-lg font-bold', f.v === 'dark' ? 'text-primary' : 'text-ink']}>{f.title}</h3>
              <p class:list={['mt-2.5 text-sm font-medium', f.v === 'dark' ? 'text-cream/80' : 'text-ink']}>{f.body}</p>
            </article>
          ))}
        </div>
        <div class="cta-banner on-dark mt-6">
          <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
            <div>
              <h3 class="font-display text-2xl tracking-normal text-primary lg:text-[28px]">
                Khóa của bạn không phải mô hình kinh doanh
              </h3>
              <p class="mt-2 max-w-2xl font-medium text-cream/80">
                Không tài khoản. Không đăng nhập. Không “gửi cho chúng tôi dữ liệu chẩn đoán”. Công cụ tính mã cho bạn ngay trên máy và sẽ vẫn như vậy dù tên miền này được phục vụ từ một chiếc USB.
              </p>
            </div>
            <a href="#generator" class="btn-primary shrink-0">
              Mở trình tạo
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 xl:px-0" aria-hidden="true">
      <hr class="border-t-2 border-dashed border-ink/40" />
    </div>

    <section id="compatibility" class="scroll-mt-20" aria-labelledby="compat-title">
      <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 lg:py-24 xl:px-0">
        <div class="mb-10 max-w-2xl">
          <p class="section-label">Tương thích</p>
          <h2 id="compat-title" class="mt-3 font-display text-3xl tracking-normal text-ink sm:text-4xl lg:text-section-display">
            Hoạt động ở mọi nơi ứng dụng xác thực hoạt động
          </h2>
          <p class="mt-4 font-medium text-ink">
            Mọi dịch vụ có tùy chọn “dùng ứng dụng xác thực” sinh ra cùng một mã TOTP chuẩn —
            kể cả các dịch vụ dưới đây:
          </p>
        </div>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {services.map((s) => (
            <li class="flex items-center justify-center rounded-full border-2 border-ink bg-surface px-3 py-3 text-sm font-semibold text-ink">{s}</li>
          ))}
        </ul>
        <p class="mt-6 text-sm font-medium text-ink">
          Đang bật 2FA cho một dịch vụ? Xem hướng dẫn từng bước:{" "}
          {[
            ['Google', 'google'],
            ['Microsoft', 'microsoft'],
            ['Discord', 'discord'],
            ['GitHub', 'github'],
            ['AWS', 'aws'],
            ['Coinbase', 'coinbase'],
            ['Steam', 'steam'],
            ['Binance', 'binance'],
          ].map(([name, slug], i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={`/guides/${slug}/`} class="link">{name}</a>
            </>
          ))}
        </p>
      </div>
    </section>

    <section id="about" class="scroll-mt-20" aria-labelledby="about-title">
      <article class="mx-auto max-w-[820px] px-4 py-20 sm:px-6 lg:py-24 xl:px-0">
        <p class="section-label">Về công cụ này</p>
        <h2 id="about-title" class="mt-3 font-display text-3xl tracking-normal text-ink sm:text-4xl lg:text-section-display">
          Trình xác thực 2FA sống ngay trong trình duyệt của bạn
        </h2>
        <div class="rich-text mt-8">
          <p>
            Mọi người đến đây với cùng một mong muốn: một mã đăng nhập hợp lệ, ngay lập tức,
            không cần cài đặt gì. Đó chính xác là 2FA COUNTER — trình xác thực và trình tạo mã
            2FA miễn phí chạy trên trình duyệt: dán khóa bí mật, kéo thả ảnh chụp mã QR hoặc quét
            bằng camera, mã tương ứng xuất hiện trong vài giây và tự làm mới mỗi 30 giây, giống
            hệt ứng dụng trên điện thoại — chỉ khác là không phải cài đặt gì cả.
          </p>

          <h3>2FA là gì? Câu trả lời 60 giây</h3>
          <p>
            2FA — xác thực hai yếu tố — là ổ khóa thứ hai trên tài khoản của bạn: thứ bạn
            <em>có</em>, bên cạnh thứ bạn <em>biết</em>. Khi bật 2FA, dịch vụ đưa bạn một khóa
            bí mật dùng chung dùng một lần. Ứng dụng xác thực sinh mã 6 chữ số từ khóa đó cộng
            thời gian hiện tại — tiêu chuẩn TOTP, RFC 6238 — trong khi trang web đăng nhập chạy
            cùng phép tính và so sánh kết quả. Vì mã xoay vòng mỗi 30 giây, một mật khẩu bị lộ
            đơn lẻ không còn mở được gì. Muốn hiểu toàn bộ phần mã hóa, đọc bài giải thích{" "}
            <a href="/what-is-2fa/">What is 2FA?</a> — hoặc quay lại và tạo mã đầu tiên của bạn.
          </p>

          <h3>Trình xác thực không bao giờ cần điện thoại của bạn</h3>
          <p>
            Phần lớn người dùng đến đây vì điện thoại không còn bên họ — bán, hỏng, ngập nước,
            bị xóa dữ liệu hoặc hết pin đúng ngày đi vắng — trong khi Google Authenticator, Authy
            và Microsoft Authenticator chỉ sống trên thiết bị đó. Công cụ 2FA trên trình duyệt
            loại bỏ điểm hỏng duy nhất đó: khóa nằm trong két của trình quản lý mật khẩu, và mã
            có thể được tạo lại trên bất kỳ máy tính nào bạn tin tưởng. Cài như ứng dụng PWA, và
            trình tạo chạy tiếp cả khi mạng bị tắt hẳn.
          </p>

          <h3>Một công cụ cho mọi dịch vụ</h3>
          <p>
            TOTP chuẩn là ngôn ngữ chung. Giao dịch trên Binance, Coinbase hay Kraken, khóa
            tài khoản AWS, Microsoft hay Google, bảo vệ Steam, Discord, X hay hộp thư — mọi
            dịch vụ có tùy chọn “dùng ứng dụng xác thực” đều nói cùng một giao thức, nên một
            công cụ phủ hết. Khi bị từ chối mã, nguyên nhân gần như luôn là đồng hồ thiết bị,
            không phải công cụ. Với các dịch vụ phổ biến, chúng tôi có{" "}
            <a href="/how-to-get-2fa-code/">hướng dẫn từng bước lấy mã 2FA</a> và các{" "}
            <a href="/guides/">hướng dẫn bật 2FA</a> theo từng dịch vụ.
          </p>

          <h3>Không gửi đi, không lưu trữ, không mất tiền</h3>
          <p>
            Không máy chủ để gửi khóa, không tài khoản, không gói cao cấp, không telemetry. Mã
            đều được tính cục bộ bằng Web Crypto API; khóa cuối cùng và danh sách khóa gần đây
            nằm trong bộ lưu trữ của trình duyệt bạn, xóa sạch chỉ bằng một cú bấm “Clear all”.
            Luôn giữ bản gốc của mọi khóa trong trình quản lý mật khẩu mã hóa, và coi bất kỳ yêu
            cầu gấp gáp nào về mã mới là dấu hiệu lừa đảo.
          </p>

          <p>
            Trình tạo đang chờ ở đầu trang. Dán khóa và nhìn mã trực tiếp đếm ngược — miễn phí,
            riêng tư, chạy ngoại tuyến, mãi mãi.
          </p>
        </div>
      </article>
