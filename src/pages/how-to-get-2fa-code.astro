   per-service guides and back to the homepage tool. */
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

// hreflang alternates for the 8 translated versions of this article
// (+ x-default → English). vi/zh variants are not published yet.
const alternates = [
  { hreflang: 'en', href: 'https://2facounter.com/how-to-get-2fa-code/' },
  { hreflang: 'es', href: 'https://2facounter.com/es/how-to-get-2fa-code/' },
  { hreflang: 'ja', href: 'https://2facounter.com/ja/how-to-get-2fa-code/' },
  { hreflang: 'fr', href: 'https://2facounter.com/fr/how-to-get-2fa-code/' },
  { hreflang: 'de', href: 'https://2facounter.com/de/how-to-get-2fa-code/' },
  { hreflang: 'pt', href: 'https://2facounter.com/pt/how-to-get-2fa-code/' },
  { hreflang: 'ko', href: 'https://2facounter.com/ko/how-to-get-2fa-code/' },
  { hreflang: 'it', href: 'https://2facounter.com/it/how-to-get-2fa-code/' },
  { hreflang: 'x-default', href: 'https://2facounter.com/how-to-get-2fa-code/' },
];

const title = 'How to Get a 2FA Code: Step-by-Step Guide (TOTP)';
const description =
  'How to get a 2FA code in three steps: reveal your setup key, paste it into the online TOTP generator, and copy the live code — plus fixes for rejected codes.';

const faq = [
  {
    q: 'Where do I find the setup key?',
    a: 'On the same screen where the service shows the QR code for its authenticator app. Look for a link like “can’t scan?”, “enter code manually”, or “show setup key”. It reveals a Base32 string (or a full otpauth:// URI) — either works in the generator.',
  },
  {
    q: 'My code is rejected — what now?',
    a: 'It is almost always clock drift. TOTP is time-based, so a device clock that is off by even half a minute produces invalid codes. Set your system time to sync automatically and try again.',
  },
  {
    q: 'Is this the same code my phone app would generate?',
    a: 'Yes. Every authenticator app — Google Authenticator, Authy, Microsoft Authenticator, or this browser tool — computes the same RFC 6238 TOTP code from the same secret and the same clock. They are interchangeable.',
  },
  {
    q: 'Do I still need my recovery codes?',
    a: 'Yes. Store them offline, separately from this tool. If you ever lose access to the device that holds your secret key, recovery codes are the way back into the account.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
      { '@type': 'ListItem', position: 2, name: 'How to get a 2FA code', item: 'https://2facounter.com/how-to-get-2fa-code/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to get a 2FA code with an online TOTP generator',
    totalTime: 'PT3M',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Turn on 2FA and reveal the setup key', text: 'Open the security settings of the service, choose the authenticator app option, and reveal the setup key when you can’t scan the QR code.' },
      { '@type': 'HowToStep', position: 2, name: 'Paste the key into the generator', text: 'Paste the Base32 string or otpauth:// URI into the generator on the 2FA COUNTER homepage. Everything is computed locally in the browser.' },
      { '@type': 'HowToStep', position: 3, name: 'Copy the live code and confirm', text: 'Type the 6-digit code into the service’s verification prompt within its 30-second window to confirm the setup — then use the same flow for every future sign-in.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
