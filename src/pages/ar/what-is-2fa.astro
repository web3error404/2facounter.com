const title = 'ما هي المصادقة الثنائية (2FA)؟ المصادقة الثنائية ورموز TOTP';
const description =
  'ما هي المصادقة الثنائية (2FA)؟ دليل بلغة مبسطة عن المصادقة الثنائية ورموز TOTP والمعيار RFC 6238، ولماذا تتفوق على SMS، وكيف لا تُقصي نفسك من حسابك أبدًا.';

const faqs = [
  {
    q: 'ما هي المصادقة الثنائية (2FA)؟',
    a: 'المصادقة الثنائية (2FA) تعني إثبات هويتك بنوعين مختلفين من الأدلة: شيء تعرفه (كلمة المرور) إضافة إلى شيء تملكه (رمز يتغير كل 30 ثانية، أو مفتاح أمان، أو هاتفك). كلمة المرور وحدها قد تُسرب أو تُخمَّن؛ أما العامل الثاني فيجعل كلمة المرور المسربة بلا فائدة إن لم يقترن بها شيء آخر.',
  },
  {
    q: 'لماذا تكتسي المصادقة الثنائية أهمية بالغة؟',
    a: 'لأن كلمات المرور تفشل دائمًا بالطريقة نفسها. مليارات كلمات المرور الحقيقية أصبحت متاحة للعموم بسبب التسريبات، والمهاجمون يعيدون استخدامها بلا كلل لاختراق حسابات الآخرين (هجمات credential stuffing) في كل الأوقات. وتشير Microsoft إلى أن المصادقة الثنائية تحجب أكثر من 99.9% من هجمات الاستيلاء الآلي على الحسابات — فهي تحمي بريدك ومصرفك وشبكاتك الاجتماعية وألعابك وعملاتك الرقمية من التهديدات التي تحدث فعلًا.',
