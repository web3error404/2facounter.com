import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Generator from '../../components/Generator.astro';

const title = 'مولّد رموز 2FA عبر الإنترنت — مصادقة 2FA مجانية (TOTP)';
const description =
  'أنشئ رمز 2FA الخاص بك عبر الإنترنت فورًا. مصادقة 2FA مجانية تعمل داخل متصفحك: الصق مفتاحك السري واحصل على رمز TOTP فوري يتجدد كل 30 ثانية. بلا تسجيل وبلا هاتف.';

const faq = [
  {
    q: 'كيف أحصل على المصادقة الثنائية (2FA)؟',
    a: 'تحصل عليها من الحساب نفسه الذي تريد حمايته: افتح إعداداته، ثم انتقل إلى «الأمان» أو «تسجيل الدخول والأمان» وابحث عن «المصادقة الثنائية» أو «التحقق بخطوتين». اختر خيار تطبيق المصادقة، وامسح رمز QR — أو اضغط «لا تستطيع المسح؟» لعرض مفتاح الإعداد (سلسلة Base32 أو رابط otpauth://) — ثم الصقه في مولّد رموز 2FA الموجود في أعلى هذه الصفحة. أدخل الرمز الفوري الذي يظهر لتأكيد الإعداد، واحفظ رموز الاسترداد التي يعرضها الخدمة.',
  },
  {
    q: 'كيف أفعّل المصادقة الثنائية (2FA)؟',
    a: 'أربع خطوات تستغرق نحو دقيقتين: 1) افتح إعدادات الحساب أو الأمان واختر «المصادقة الثنائية». 2) اختر «استخدام تطبيق مصادقة» (وتجنّب الرسائل النصية SMS إن وُجد خيار أفضل). 3) امسح رمز QR بمصادقك — أو اعرض مفتاح الإعداد واحفظه إن تعذّر المسح. 4) أدخل الرمز الفوري لإنهاء العملية، ثم نزّل رموز الاسترداد أو اطبعها. ننشر أدلة لكل خدمة تشمل Google وGitHub وDiscord وBinance وغيرها.',
  },
  {
    q: 'كيف تعمل المصادقة الثنائية (2FA)؟',
    a: 'بعد كلمة المرور، يطلب الخدمة دليل هوية ثانيًا. في الطريقة القياسية TOTP (المعيار RFC 6238) يحسب المصادق لديك رمزًا من 6 أرقام انطلاقًا من مفتاح سري مشترك مضافًا إليه الوقت الحالي، ويجري الخادم الحسابَ نفسه ثم يقارن بين الناتجين. يُشتق رمز التحقق بخطوتين من جديد كل 30 ثانية وينتهي نفاذُه فور انتهاء مدته — وبذلك لا يكفي تسريب كلمة المرور وحدها لفتح حسابك.',
  },
  {
    q: 'ما فائدة المصادقة الثنائية (2FA)؟',
    a: 'تحمي أي عملية تسجيل دخول يشتهيها الآخرون: البريد وحزم العمل السحابية (Google وMicrosoft وApple)، والخدمات المصرفية والوساطة عبر الإنترنت، ومنصات تبادل العملات الرقمية (Binance وCoinbase وKraken)، ومنصات المطوّرين (GitHub وAWS)، وألعاب الفيديو (Steam وDiscord وTwitch)، وشبكات التواصل الاجتماعي (X وInstagram). كما تستخدمها الشركات لحماية الشبكات الافتراضية الخاصة (VPN) والبريد ولوحات الإدارة. وفي أي خدمة توفر خيار «تطبيق مصادقة»، هناك يقع مدخل المصادقة الثنائية.',
  },
  {
    q: 'هل المصادقة الثنائية آمنة بنسبة 100%؟',
    a: 'لا — وليس أي إجراء أمني آمنًا بهذه النسبة؛ والحق تقوله الأدلة الأمينة. المصادقة الثنائية تحسم هجمات كلمات المرور المسروقة، لكن رمزًا مولّدًا للتو إن كُتب في موقع مزيف أثناء صلاحيته سينتهي به المطاف في احتيال تصيّد، وبرمجيات خبيثة موجودة أصلًا في جهازك قد تختطف الجلسة نفسها، أما رموز SMS فتسقط أمام هجمات انتحال شريحة SIM. ومع كل ذلك، يبقى فتح حساب محمي بالمصادقة الثنائية أصعب بكثير من حساب بلا حماية.',
  },
  {
    q: 'هل المصادقة الثنائية إلزامية؟',
    a: 'لا تفرضها أي حكومة، لكن المنصات تفرضها تباعًا: GitHub تشترطها على من يساهمون بالشيفرة منذ 2023، والمصارف ومنصات تبادل العملات الرقمية تفرضها، وأصحاب العمل يطلبونها عادة للوصول إلى أنظمة العمل. وفي بقية الحالات فهي اختيارية لكنها شديدة التوصية بها. عامِلها كإلزامية في أثمن حساباتك — البريد الإلكتروني: فمن يسيطر على صندوق بريدك يستطيع استعادة جميع الحسابات الأخرى.',
  },
  {
    q: 'لماذا تكتسي المصادقة الثنائية أهمية بالغة؟',
    a: 'لأن كلمات المرور تفشل دائمًا بالطريقة نفسها. مليارات كلمات المرور الحقيقية أصبحت متاحة للعموم بسبب التسريبات، والمهاجمون يعيدون استخدامها بلا كلل في موقع بعد موقع (هجمات إعادة استخدام بيانات الاعتماد المسروقة — credential stuffing). وتشير Microsoft إلى أن المصادقة الثنائية تحجب أكثر من 99.9% من محاولات الاستيلاء الآلي على الحسابات — وهي التحسين الأقل كلفة الذي يحمي بريدك ومصرفك وألعابك وعملاتك الرقمية من التهديدات التي تحدث فعلًا.',
  },
  {
    q: 'ما مدى قوة المصادقة الثنائية؟',
    a: 'يعتمد ذلك كليًا على العامل الثاني. رموز SMS هي الأضعف: فمع هجوم انتحال شريحة SIM يسرق المهاجم رقمك ويستلم الرموز بنفسه. أما رموز TOTP من المصادق — رموز الـ30 ثانية — فهي قوية حسابيًا: لا يُبثّ شيء عبر الشبكة، ولا يمكن للمهاجم خارج الاتصال استنتاجها، وينتهي نفاذ كل رمز خلال ثوانٍ. ومفاتيح الأمان المادية ومفاتيح المرور (passkeys) هي الأقوى على الإطلاق، لأنها تصمد أمام التصيّد وترتبط تشفيريًا بالنطاق الحقيقي.',
  },
  {
    q: 'لماذا يعتمد الجميع المصادقة الثنائية الآن؟',
    a: 'لأن عصر كلمة المرور المجردة انهار. فقد كشفت التسريبات الواسعة مليارات من بيانات الاعتماد، وجعلت هجمات إعادة الاستخدام الآلية الاستيلاء على الحسابات شبه مجاني، وضقت المنصاتُ سدةً دفع ثمن الضرر. ثم جاءت الهيئات الرقابية: فمؤسسة NIST استبعدت SMS من معايير المصادقة في الولايات المتحدة، ويتطلب نظام PSD2 الأوروبي مصادقة قوية للعميل. وعندما أدخلَ عددٌ قليل من العمالقة المصادقةَ الثنائية إلى التيار العام، سارت خلفهم بقية الخدمات جميعًا.',
  },
  {
    q: 'هل أحتاج إلى هاتف لاستخدام مصادق 2FA هذا؟',
    a: 'لا. إنها أداة 2FA تعمل داخل المتصفح: تعمل على أي حاسوب محمول أو جهاز لوحي أو مكتبي فيه متصفح حديث، عبر الإنترنت أو دون اتصال تمامًا بعد تثبيتها كتطبيق. تحلّ محل تطبيق الهاتف حين يُفقد الهاتف أو يُباع أو يتعطل أو ينفد بطاريته — أو حين يُمنع استخدام الهواتف ببساطة في مكان عملك.',
  },
  {
    q: 'هل استخدام 2FA COUNTER آمن؟',
    a: 'نعم. يجري كل حساب محليًا في متصفحك عبر واجهة Web Crypto API. مفاتيحك السرية لا تُرسل مطلقًا إلى — ولا تُعرض على — أي خادم. ويمكنك فتح الصفحة ثم قطع الاتصال بالإنترنت وسيظل المولّد يعمل.',
  },
  {
    q: 'هل يمكنني استخدامه دون اتصال بالإنترنت؟',
    a: 'بالتأكيد. ثبّت 2FA COUNTER كتطبيق (إضافة إلى الشاشة الرئيسية / تثبيت) وسيعمل دون اتصال بالكامل كمصادق أصلي. فالرموز تُشتق من مفتاحك وساعة جهازك — ولا حاجة إلى شبكة.',
  },
  {
    q: 'لماذا يُرفض رمز 2FA لديّ؟',
    a: 'السبب في معظم الأحيان هو انحراف الساعة. فرموز TOTP تعتمد على الوقت: إذا كانت ساعة جهازك منحرفة ولو نصف دقيقة، يصبح الرمز غير صالح. تأكد من ضبط وقت النظام على المزامنة التلقائية (في Windows، «المزامنة الآن» في إعدادات التاريخ والوقت؛ وفي macOS، «ضبط التاريخ والوقت تلقائيًا») ثم أعد المحاولة. يحسب المولّد بالوقت الذي يبلغ عنه جهازك — وليس لديه ساعة خاصة يصححها.',
  },
  {
    q: 'ما الفرق بينه وبين Google Authenticator أو Authy؟',
    a: 'هي تطبيقات هاتف، أما هذا فمصادق يعمل في المتصفح. يستخدم خوارزمية TOTP ذاتها من معيار RFC 6238 بالضبط، ويعمل مع كل خدمة تقبل تطبيق مصادقة قياسي — لكنك لن تفقد الوصول أبدًا لأن الهاتف تعطل أو بيع أو نفدت بطاريته.',
  },
  {
    q: 'أين تُخزَّن مفاتيحي؟',
    a: 'في متصفحك وحده. يُحفظ آخر مفتاح لديك وقائمة قصيرة بـ«المفاتيح الأخيرة» (حتى 8 مفاتيح) في التخزين المحلي لهذا الجهاز كي يصمد المولّد أمام إعادة التحميل وتنقلك بين المفاتيح بنقرة واحدة — ولا يُحفظ شيء في خوادمنا لأنه لا توجد خوادمنا أصلًا. تُحفظ المفاتيح كنص صريح: فمن يفتح هذا الملف الشخصي للمتصفح يستطيع قراءتها، لذا عامِل الملف الشخصي كما تعامل مع خزانة مدير كلمات مرور. زر «حذف الكل» أعلى القائمة — وهو يطلب التأكيد — وإفراغ الحقل ومسح بيانات المتصفح، كلها تحذفها إلى الأبد؛ لذا احفظ السر الأصلي في مدير كلمات المرور نسخةً رئيسية.',
  },
  {
    q: 'هل يعمل مع HOTP أو رموز 8 أرقام أو خدمات SHA-256؟',
    a: 'نعم. الصق رابط otpauth:// الكامل الذي يوفره لك الخدمة وستُحترم تلقائيًا جميع المعاملات التي يحملها — 6 أو 7 أو 8 أرقام، وفترات 15/30/60 ثانية، وتواقيع SHA-1/SHA-256/SHA-512، وHOTP القائم على العدّاد. أما مفتاح Base32 المجرد فيُفسَّر بالقيم القياسية الافتراضية (6 أرقام، 30 ثانية، SHA-1)، وهي القيم التي تستخدمها الغالبية العظمى من الخدمات.',
  },
  {
    q: 'هل هو مجاني فعلًا؟',
    a: 'نعم — بلا حسابات، وبلا خطة مميزة، وبلا تسجيل دخول. إنها أداة، لا خدمة.',
  },
];

