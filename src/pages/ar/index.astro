  <Layout title={title} description={description} path="/ar/" lang="ar" jsonLd={jsonLd} alternates={homeAlternates} image="/og-ar.png">
    <SiteHeader locale="ar"


    links={[
      { href: '/ar/#how-it-works', label: 'كيف يعمل' },
      { href: '/ar/#features', label: 'المزايا' },
      { href: '/ar/#faq', label: 'الأسئلة الشائعة' },
      { href: '/guides/', label: 'الأدلة' },
      { href: '/privacy/', label: 'الخصوصية' },
    ]}
    cta="أنشئ رمزي الآن"
  />

  <main id="main">
    <!-- ── اللوحة البرتقالية: المولّد الفوري في الأعلى، والمقدمة تحته ── -->
    <section aria-label="مولّد رموز 2FA الفوري">
      <!-- القسم 1: واجهة مولّد 2FA في قمة الصفحة -->
      <div class="mx-auto max-w-[1200px] px-4 pt-10 pb-4 sm:px-6 sm:pt-16 xl:px-0">
        <Generator locale="ar" />
      </div>

      <!-- القسم 2: محتوى المقدمة أسفل المولّد مباشرة -->
      <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-4 pt-14 pb-12 sm:px-6 sm:pt-20 lg:grid-cols-[7fr_5fr] lg:pt-24 xl:px-0">
        <div>
          <span class="badge-eyebrow -rotate-1">100% داخل متصفحك · zero-knowledge</span>
          <h1 class="mt-6 max-w-[11em] font-display text-display-xl tracking-normal text-ink lg:text-display-xxl">
            مولّد رموز 2FA الفوري
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-[1.5] font-medium text-ink lg:text-xl">
            الصق مفتاحًا سريًا واحصل على رمز من 6 أرقام فورًا. بديل لـ
            Google Authenticator وAuthy وMicrosoft Authenticator: سريع ومجاني وخاص —
            لحين يُفقد الهاتف أو يتعطل أو ببساطة لا يكون في متناول اليد.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#generator" class="btn-primary">
