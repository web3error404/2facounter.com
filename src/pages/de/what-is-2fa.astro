  <Layout title={title} description={description} path="/de/what-is-2fa/" lang="de" jsonLd={jsonLd} alternates={alternates} image="/og-de.png">
    <SiteHeader locale="de"

  
    links={[
      { href: '/de/', label: '2FA-Code generieren' },
      { href: '/de/how-to-get-2fa-code/', label: '2FA-Code abrufen' },
