            transform="translate(2 2)"
            fill="rgb(42 31 26 / 0.15)"></path>
          <path
            d="M27.74 -1.15Q27.74 -0.62 24.82 -0.31Q21.89 0.00 18.96 0.00Q16.03 0.00 15.19 -0.26Q14.35 -0.53 14.35 -1.15L14.35 -7.06L2.35 -7.06Q0.72 -7.06 0.72 -15.02Q0.72 -15.94 4.63 -22.85Q8.54 -29.76 10.03 -31.92Q10.61 -32.74 14.35 -33.46Q18.10 -34.18 21.65 -34.18Q27.74 -34.18 27.74 -31.92L27.74 -1.15ZM15.17 -14.54L15.22 -25.01L11.86 -14.54ZM53.78 -0.26Q53.78 -0.26 52.43 0.08Q51.07 0.43 47.09 0.43Q43.10 0.43 40.39 -0.26Q37.68 -0.96 35.47 -2.83Q31.10 -6.53 31.10 -17.28Q31.10 -27.65 35.66 -31.34Q37.92 -33.17 40.61 -33.89Q43.30 -34.61 47.06 -34.61Q50.83 -34.61 53.54 -33.89Q56.26 -33.17 58.51 -31.34Q63.07 -27.65 63.07 -17.28Q63.07 -6.53 58.70 -2.83Q56.50 -0.96 53.78 -0.26ZM46.08 -7.73Q46.46 -7.10 47.11 -7.10Q47.76 -7.10 48.14 -7.75Q48.53 -8.40 48.77 -10.61Q49.01 -12.82 49.01 -16.90Q49.01 -20.98 48.77 -23.26Q48.53 -25.54 48.14 -26.28Q47.76 -27.02 47.11 -27.02Q46.46 -27.02 46.08 -26.30Q45.12 -24.67 45.12 -16.90Q45.12 -9.17 46.08 -7.73ZM92.26 -1.15Q92.26 -0.62 89.33 -0.31Q86.40 0.00 83.47 0.00Q80.54 0.00 79.70 -0.26Q78.86 -0.53 78.86 -1.15L78.86 -7.06L66.86 -7.06Q65.23 -7.06 65.23 -15.02Q65.23 -15.94 69.14 -22.85Q73.06 -29.76 74.54 -31.92Q75.12 -32.74 78.86 -33.46Q82.61 -34.18 86.16 -34.18Q92.26 -34.18 92.26 -31.92L92.26 -1.15ZM79.68 -14.54L79.73 -25.01L76.37 -14.54Z"
            fill="#d32f2f"></path>
        </svg>
        <p class="mt-5 text-sm font-medium text-ink sm:text-base">
          The address you typed doesn’t exist here — maybe it was moved, mistyped, or never
          existed at all. Nothing to worry about: no keys, no accounts, nothing lost.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="/" class="btn-primary">Back to the homepage</a>
          <a href="/guides/" class="btn-secondary">Browse 2FA guides</a>
        </div>
        <p class="mt-6 text-sm font-medium text-ink/90">
          Looking for the generator?{" "}
          <a href="/#generator" class="link">Open a live TOTP code</a> — it works entirely in your
          browser, from any page.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
