---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Page not found — 2FA COUNTER';
const description =
  'The page you were looking for doesn’t exist on 2facounter.com. Head back to the homepage to generate live TOTP codes, or browse our step-by-step 2FA guides.';
---

<Layout title={title} description={description} path="/404/" noindex>
  <SiteHeader />
  <main id="main">
    <div class="mx-auto max-w-[720px] px-4 py-20 sm:px-6 lg:py-24">
      <p class="section-label">Error 404</p>
      <h1 class="mt-3 font-display text-4xl tracking-normal text-ink">
        This page slipped off the ticket roll
      </h1>

      <div
        class="mt-12 rounded-xl border-2 border-ink bg-cream p-6 text-center sm:p-10"
        style="box-shadow: var(--shadow-card)"
      >
        <!-- Oversized code stamp, tilted like a date stamp.
             "404" as static Titan One outlines (no webfont) — generated with
             tools/og/wordmark-gen.mjs. Height matches the old text-7xl /
             text-8xl glyph box: 35.04/48 × 72px ≈ 53px, × 96px ≈ 70px. -->
        <svg
          class="mx-auto h-[53px] w-auto sm:h-[70px]"
          viewBox="0.72 -34.61 91.54 35.04"
          fill="none"
          aria-hidden="true"
        >
