const faq = [
  {
    q: 'Onde encontro a chave de configuração?',
    a: 'Na mesma tela em que o serviço exibe o QR Code para o aplicativo autenticador. Procure um link como “não consegue escanear?”, “digitar o código manualmente” ou “mostrar a chave de configuração”. Ele revela uma string Base32 (ou um URI otpauth:// completo) — ambas funcionam no gerador.',
