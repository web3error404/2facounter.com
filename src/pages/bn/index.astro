      { href: '/guides/', label: 'গাইড' },
      { href: '/privacy/', label: 'প্রাইভেসি' },
    ]}
    cta="আমার কোড তৈরি করুন"
  />

  <main id="main">
    <!-- ── কমলা ক্যানভাস: ওপরে লাইভ জেনারেটর, তার নিচে হিরো ── -->
    <section aria-label="লাইভ 2FA কোড জেনারেটর">
      <!-- সেকশন 1: 2FA জেনারেটরের ইন্টারফেস, সবার ওপরে -->
