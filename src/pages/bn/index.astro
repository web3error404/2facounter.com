    </div>

    <!-- ── সংখ্যায় zero-knowledge ── -->
    <section aria-label="সংখ্যায় zero-knowledge">
      <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-4 py-16 text-center sm:grid-cols-3 sm:px-6 lg:py-20 xl:px-0">
        <div>
          <p class="font-numeric text-5xl font-black tracking-[-0.03125em] text-ink lg:text-[56px]">0</p>
          <p class="mt-2 text-sm font-medium text-ink">আমাদের পাশে জমা করা কী — সার্ভারই নেই যেখানে রাখা যায়</p>
        </div>
        <div>
          <p class="font-numeric text-5xl font-black tracking-[-0.03125em] text-ink lg:text-[56px]">100%</p>
          <p class="mt-2 text-sm font-medium text-ink">হিসাব হয় আপনার ডিভাইসেই, Web Crypto দিয়ে</p>
        </div>
        <div>
          <p class="font-numeric text-5xl font-black tracking-[-0.03125em] text-ink lg:text-[56px]">6238</p>
          <p class="mt-2 text-sm font-medium text-ink">বাস্তবায়িত RFC স্ট্যান্ডার্ড — সব অথেন্টিকেটর অ্যাপের সঙ্গে সামঞ্জস্যপূর্ণ</p>
        </div>
      </div>
    </section>

    <!-- ── কীভাবে কাজ করে ── -->
    <section id="how-it-works" class="scroll-mt-20" aria-labelledby="how-title">
      <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 lg:py-24 xl:px-0">
        <div class="grid items-start gap-12 lg:grid-cols-[5fr_7fr]">
          <div>
            <p class="section-label">কীভাবে কাজ করে</p>
            <h2 id="how-title" class="mt-3 font-display text-3xl tracking-normal text-ink sm:text-4xl lg:text-section-display">
              মোবাইল ছাড়াই তিন ধাপে আপনার লাইভ 2FA কোড।
            </h2>
            <p class="mt-5 text-lg font-medium text-ink">
              দুই ধাপের ভেরিফিকেশন আপনার অ্যাকাউন্টে দ্বিতীয় তালাবন্ধ যোগ করে: একটি কোড যা
              প্রতি 30 সেকেন্ডে বদলায় আর একটি শেয়ার করা সিক্রেট কী আর বর্তমান সময় থেকে তৈরি
              হয় (TOTP — RFC 6238)। এই পেজটিই সেই দ্বিতীয় তালা। আপনার ব্রাউজার হুবহু সেই
              হিসাবটিই চালায়, যেটি লগইন করা সাইটটি চালায়।
