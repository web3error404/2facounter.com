const title = '2FA কোড কীভাবে পাব: ধাপে ধাপে গাইড (TOTP)';
const description =
  'তিন ধাপে 2FA কোড কীভাবে পাবেন: সেটআপ কী দেখান, অনলাইন TOTP জেনারেটরে পেস্ট করুন আর লাইভ কোড কপি করুন — সঙ্গে কোড না মানলে সমাধান।';

const faq = [
  {
    q: 'সেটআপ কী কোথায় পাব?',
    a: 'সার্ভিস যে পর্দায় অথেন্টিকেটর অ্যাপের জন্য QR কোড দেখায়, সেখানেই। “স্ক্যান করতে পারছেন না?”, “কোড ম্যানুয়ালি লিখুন” বা “সেটআপ কী দেখান” ধাঁচের একটি লিংক খুঁজুন। খুললেই একটি Base32 স্ট্রিং (বা সম্পূর্ণ otpauth:// URI) প্রকাশ হয় — দুটোরই জেনারেটরে কাজ করে।',
  },
  {
    q: 'কোড গ্রহণ করা হচ্ছে না, কী করব?',
    a: 'প্রায় সবসময়ই কারণ ঘড়ির ফারাক। TOTP সময়ের ওপর নির্ভরশীল: ঘড়ি অর্ধেক মিনিটও এদিক-ওদিক থাকলে কোড অবৈধ হয়। সিস্টেমের সময় অটোমেটিক সিঙ্কে রাখুন আর আবার চেষ্টা করুন।',
  },
  {
    q: 'এটি কি আমার ফোনের অ্যাপের তৈরি কোডেরই সমান?',
    a: 'হ্যাঁ। প্রতিটি অথেন্টিকেটর অ্যাপ — Google Authenticator, Authy, Microsoft Authenticator বা এই ব্রাউজার টুল — একই সিক্রেট আর একই ঘড়ি থেকে RFC 6238-এর একই TOTP কোড হিসাব করে। একে অপরের বিকল্প।',
  },
  {
    q: 'রিকভারি কোডগুলো তবু দরকার?',
    a: 'হ্যাঁ। এই টুল থেকে আলাদা করে অফলাইনে সংরক্ষণ করুন। সিক্রেট কী-এর ডিভাইসে অ্যাক্সেস কখনো হারালে অ্যাকাউন্টে ফেরার একমাত্র পথ রিকভারি কোডগুলোই।',
  },
];

