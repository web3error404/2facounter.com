    totalTime: 'PT3M',
    step: [
      { '@type': 'HowToStep', position: 1, name: '2FA চালু করে সেটআপ কী দেখান', text: 'সার্ভিসের সিকিউরিটি সেটিংস খুলুন, অথেন্টিকেটর অ্যাপের অপশন বেছে নিন, আর QR কোড স্ক্যান করা না গেলে সেটআপ কী দেখান।' },
      { '@type': 'HowToStep', position: 2, name: 'কী জেনারেটরে পেস্ট করুন', text: 'Base32 স্ট্রিং বা otpauth:// URI 2FA COUNTER-এর হোমপেজের জেনারেটরে পেস্ট করুন। সব হিসাব হয় ব্রাউজারেই, লোকালি।' },
      { '@type': 'HowToStep', position: 3, name: 'লাইভ কোড কপি করে নিশ্চিত করুন', text: '6 ডিজিটের কোডটি 30 সেকেন্ডের মেয়াদের মধ্যে সার্ভিসের ভেরিফিকেশন পর্দায় ঢুকিয়ে সেটআপ নিশ্চিত করুন — ভবিষ্যতের প্রতিটি লগইনে একই ধাপ ঘুরবে।' },
