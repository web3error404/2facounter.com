---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Terms of Service — 2FA COUNTER';
const description =
  'Terms of service for 2FA COUNTER (2facounter.com): a free, as-is, client-side TOTP tool. No accounts, no warranties, plain terms.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: 'https://2facounter.com/terms/',
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
        { '@type': 'ListItem', position: 2, name: 'Terms of service', item: 'https://2facounter.com/terms/' },
      ],
    },
  },
];
---

<Layout title={title} description={description} path="/terms/" jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <div class="mx-auto max-w-[720px] px-4 py-20 sm:px-6 lg:py-24">
      <p class="section-label">Legal</p>
      <h1 class="mt-3 font-display text-4xl tracking-normal text-ink">Terms of service</h1>
      <p class="mt-4 font-mono text-label font-bold text-ink">Effective · November 8, 2026</p>

      <div class="rich-text mt-12 rounded-xl border-2 border-ink bg-cream p-6 sm:p-10" style="box-shadow: var(--shadow-card)">
        <blockquote>
          The short version: the tool is free, provided as-is, and we are not liable for what you
          do with it. Don’t enter keys you don’t own.
        </blockquote>

        <h2>What this is</h2>
        <p>
          2FA COUNTER (2facounter.com) is a free, browser-based generator for time-based
          one-time passwords (TOTP, RFC 6238) and counter-based codes (HOTP). It runs entirely in
          your web browser: keys and codes are processed on your device and are never transmitted
          to us or stored by us, as described in <a href="/privacy/">the privacy policy</a>.
        </p>

        <h2>Acceptance</h2>
        <p>
          By using the site you agree to these terms. If you do not agree, do not use the tool.
          There is no account to create and nothing to sign — these terms apply simply because
          the website is available to you.
        </p>

        <h2>No accounts, no fees</h2>
        <p>
          The tool is offered free of charge to everyone. There are no user accounts, no
          subscriptions, and no paid tiers. We may change, suspend, or discontinue any part of
          the site at any time without notice.
        </p>

        <h2>Acceptable use</h2>
        <ul>
          <li>
            Only use the tool with secret keys that belong to you or that you are authorized to
            manage. Generating codes for accounts you do not control is prohibited.
          </li>
          <li>Do not attempt to disrupt, overload, or reverse the availability of the site.</li>
          <li>
            Do not use the tool as part of automation, phishing, or any activity that violates
            the terms of service of third-party platforms.
          </li>
        </ul>

        <h2>No warranty</h2>
        <p>
          The tool is provided <strong>“as is” and “as available”</strong>, without warranties of
          any kind, express or implied, including merchantability, fitness for a particular
          purpose, and non-infringement. We do not warrant that the tool will be uninterrupted,
          error-free, or that generated codes will always be accepted by every service. TOTP
          depends on your device clock being accurate — clock drift is the user’s side of the
          setup.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          To the maximum extent permitted by law, 2FA COUNTER and its operators are not liable
          for any indirect, incidental, or consequential damages, including account lockouts,
          lost access, data loss, or security incidents, arising from the use or inability to use
          this tool. <strong>Always keep your original secret keys and recovery codes in a safe
          place — a password manager and offline storage</strong> — before relying on any
          authenticator, including this one.
        </p>

        <h2>Intellectual property & trademarks</h2>
        <p>
          The site’s name, design, and code are the property of 2FA COUNTER. All third-party
          names, trademarks, and service names mentioned on this site (e.g. Discord, GitHub,
          Steam, Binance) belong to their respective owners. Their use is nominative and for
          reference only; this site is <strong>not affiliated with, endorsed by, or sponsored
          by</strong> any of them.
        </p>
        <p>
          You believe content on this site infringes your copyright, trademark, or other
          intellectual property? Email{" "}
          <a href="mailto:support@2facounter.com">support@2facounter.com</a> (mark it to the
          attention of the IP desk) with the work
          identified (URL and description), your contact details, and a statement of good-faith
          authority. Every report gets a reply, and valid requests are resolved — typically
          fixed or removed — within a few business days.
        </p>

        <h2>Security</h2>
        <p>
          Found a vulnerability? Please report it rather than exploit it — see
          <a href="/contact/">the contact page</a> for our <code>security@</code> channel.
        </p>

        <h2>Changes</h2>
        <p>
          These terms may be updated to reflect changes in the tool or applicable law. The
          effective date above will change accordingly. Questions? Write to
          <a href="/contact/">the contact page</a>.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
