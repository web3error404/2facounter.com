  <Layout title={title} description={description} path="/es/what-is-2fa/" lang="es" jsonLd={jsonLd} alternates={alternates} image="/og-es.webp">
    <SiteHeader locale="es"

  
    links={[
      { href: '/es/', label: 'Generar código 2FA' },
      { href: '/es/how-to-get-2fa-code/', label: 'Cómo obtener un código 2FA' },
