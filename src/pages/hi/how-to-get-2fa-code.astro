  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'ऑनलाइन TOTP जेनरेटर से 2FA कोड कैसे मिलता है',
    totalTime: 'PT3M',
    step: [
      { '@type': 'HowToStep', position: 1, name: '2FA चालू करें और सेटअप की दिखाएँ', text: 'सर्विस की सिक्योरिटी सेटिंग्स खोलें, ऑथेंटिकेशन ऐप का विकल्प चुनें, और QR स्कैन न हो तो सेटअप की दिखाएँ।' },
      { '@type': 'HowToStep', position: 2, name: 'की जेनरेटर में पेस्ट करें', text: 'Base32 स्ट्रिंग या otpauth:// URI 2FA COUNTER के होमपेज जेनरेटर में पेस्ट करें। सब कुछ ब्राउज़र में ही लोकल बनता है।' },
      { '@type': 'HowToStep', position: 3, name: 'लाइव कोड कॉपी करके कन्फ़र्म करें', text: '6 अंकों का कोड सर्विस की वेरिफिकेशन स्क्रीन पर अपनी 30 सेकंड की विंडो के भीतर डालकर सेटअप कन्फ़र्म करें — और आगे हर लॉगिन पर वही फ़्लो दोहराएँ।' },
    ],
  },
  {
