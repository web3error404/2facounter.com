const faq = [
  {
    q: 'सेटअप की कहाँ मिलती है?',
    a: 'उसी स्क्रीन पर जहाँ सर्विस अपनी ऑथेंटिकेशन ऐप के लिए QR कोड दिखाती है। “स्कैन नहीं हो पा रहा?”, “कोड मैन्युअली डालें” या “सेटअप की दिखाएँ” जैसा कोई लिंक ढूँढें। खोलते ही एक Base32 स्ट्रिंग (या पूरा otpauth:// URI) खुल जाता है — दोनों में से कोई भी जेनरेटर में चल जाता है।',
  },
  {
