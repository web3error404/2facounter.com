---
/* Hindi translation of /what-is-2fa/ (hreflang: hi). Structure
   parallel to the original; translation adapted for Hindi SEO. */
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = '2FA क्या है? टू-फ़ैक्टर ऑथेंटिकेशन और TOTP कोड की पूरी समझ';
const description =
  '2FA क्या है? टू-फ़ैक्टर ऑथेंटिकेशन, TOTP कोड, RFC 6238, यह SMS से बेहतर क्यों है और आप कभी बाहर क्यों नहीं रहेंगे — आसान भाषा में पूरी गाइड। फ्री 2FA कोड…';

const faqs = [
  {
    q: '2FA क्या है?',
    a: '2FA (टू-फ़ैक्टर ऑथेंटिकेशन) का मतलब है अपनी पहचान दो अलग तरह के सबूतों से साबित करना: कुछ जो आपको पता है (आपका पासवर्ड) और कुछ जो आपके पास है (हर 30 सेकंड में बदलने वाला कोड, सिक्योरिटी की या आपका फ़ोन)। अकेला पासवर्ड लीक हो सकता है या अंदाज़े से पकड़ा जा सकता है; दूसरा फ़ैक्टर लीक हुए पासवर्ड को बेअसर कर देता है अगर उसके साथ कुछ और न हो।',
  },
  {
    q: '2FA इतना ज़रूरी क्यों है?',
    a: 'क्योंकि पासवर्ड हर बार एक ही तरह फेल होते हैं। लीक से अरबों असली पासवर्ड पहले से सार्वजनिक हैं, और हमलावर उन्हें दिन-रात दूसरों के अकाउंट्स में घुसने के लिए बार-बार इस्तेमाल करते हैं (क्रेडेंशियल स्टफ़िंग)। Microsoft के मुताबिक़ 2FA 99.9% से ज़्यादा ऑटोमेटेड अकाउंट-टेकओवर हमलों को रोकता है — आपके ईमेल, बैंक, सोशल मीडिया, गेम्स और क्रिप्टो को ठीक उन्हीं असली ख़तरों से बचाता है जो सच में घटित होते हैं।',
  },
  {
    q: '2FA किस काम आता है?',
    a: 'हर उस लॉगिन की रक्षा करता है जिसे चुराना बेशक़ीमती हो: ईमेल और क्लाउड अकाउंट्स (Google, Microsoft, Apple), बैंकिंग और फ़ाइनैंस, क्रिप्टो एक्सचेंज (Binance, Coinbase, Kraken), डेवलपर प्लेटफ़ॉर्म (GitHub, AWS), गेमिंग (Steam, Discord, Twitch) और सोशल मीडिया (X, Instagram)। कंपनियाँ इसे VPN, ईमेल और एडमिन कंसोल के लिए भी इस्तेमाल करती हैं। जहाँ सर्विस “ऑथेंटिकेशन ऐप” का विकल्प दे, समझिए 2FA का सही औज़ार वहीं है।',
  },
  {
    q: '2FA काम कैसे करता है?',
    a: 'पासवर्ड के बाद सर्विस दूसरा सबूत माँगती है। सबसे आम तरीके (TOTP) में आपका ऑथेंटिकेटर एक शेयर्ड सीक्रेट की और मौजूदा समय से नया 6 अंकों का कोड बनाता है (RFC 6238 स्टैंडर्ड), और सर्वर वही कैलकुलेशन करके नतीजे मिलाता है। कोड हर 30 सेकंड में बदलता है और दोबारा इस्तेमाल नहीं हो सकता, इसलिए जिसके पास सिर्फ़ आपका पासवर्ड हो, वह भी अंदर नहीं घुस सकता।',
  },
  {
    q: 'TOTP कोड कैसे बनता है?',
    a: 'वेबसाइट आपको एक सीक्रेट की देती है (आमतौर पर QR कोड या Base32 स्ट्रिंग के रूप में)। आपका ऑथेंटिकेटर उस की से, मौजूदा 30 सेकंड की टाइम विंडो पर HMAC (SHA-1, SHA-256 या SHA-512 के साथ) हिसाब करता है और नतीजे से 6 अंक निकालता है। वेबसाइट वही कैलकुलेशन करके मिलाती है। नेटवर्क की ज़रूरत नहीं, क्योंकि दोनों पास सीक्रेट पहले से मौजूद है।',
  },
  {
    q: '2FA कैसे मिलता है?',
    a: '2FA उसी अकाउंट से मिलता है जिसे आपको सुरक्षित करना है: उसकी सेटिंग्स खोलें, “सेक्योरिटी” या “साइन-इन और सिक्योरिटी” सेक्शन में जाएँ और “टू-फ़ैक्टर ऑथेंटिकेशन” या “टू-स्टेप वेरिफिकेशन” ढूँढें। ऑथेंटिकेशन ऐप का विकल्प चुनें, QR कोड स्कैन करें (या सेटअप की दिखाएँ) और अपने ऑथेंटिकेटर का कोड डालकर कन्फ़र्म करें। हमारी स्टेप-बाय-स्टेप गाइड बताती है कि बिना मोबाइल कोड कैसे मिलता है: /hi/how-to-get-2fa-code/।',
  },
  {
    q: '2FA कैसे चालू करें?',
    a: 'चार स्टेप: 1) सर्विस की अकाउंट या सिक्योरिटी सेटिंग्स खोलें और “टू-फ़ैक्टर ऑथेंटिकेशन” चुनें। 2) “ऑथेंटिकेशन ऐप इस्तेमाल करें” चुनें (हो सके तो SMS से बचें)। 3) QR कोड अपने ऑथेंटिकेटर से स्कैन करें — या “स्कैन नहीं हो पा रहा?” पर क्लिक करके सेटअप की सेव करें। 4) लाइव कोड डालकर प्रोसेस पूरी करें और जो बैकअप कोड दिखें, उन्हें डाउनलोड या प्रिंट कर लें। Google, GitHub, Discord, Binance समेत कई सर्विसेज़ की सेटअप गाइड्स हम /guides/ पर प्रकाशित करते हैं।',
  },
  {
    q: '2FA कितना मज़बूत है?',
    a: 'यह पूरी तरह इस बात पर है कि दूसरा फ़ैक्टर क्या है। SMS कोड सबसे कमज़ोर हैं — SIM-स्वैप में हमलावर आपका नंबर हथियाकर कोड ख़ुद पाता है। ऑथेंटिकेटर के TOTP कोड — 30 सेकंड वाले — कम्प्यूटेशनल तौर पर मज़बूत हैं: ऑफ़लाइन हमलावर उन्हें अंदाज़ा नहीं लगा सकता और हर कोड सेकंडों में एक्सपायर हो जाता है। फ़िज़िकल सिक्योरिटी कीज़ और पासकीज़ सबसे मज़बूत हैं, क्योंकि वे फ़िशिंग के ख़िलाफ़ टिकती हैं और क्रिप्टोग्राफ़िक तौर पर असली डोमेन से बँधी होती हैं।',
  },
  {
    q: 'क्या 2FA 100% सुरक्षित है?',
    a: 'कोई सिक्योरिटी उपाय 100% नहीं होता, और ईमानदार 2FA गाइड्स यही मानती हैं। 2FA चोरी हुए पासवर्ड को हरा देता है, लेकिन फ़िशिंग साइट पर 30 सेकंड की वैलिड विंडो में ताज़ा कोड टाइप कर दिया तो कोड फिर भी पकड़ में आ सकता है; डिवाइस में पहले से मौजूद मैलवेयर सेशन चुरा सकता है; और दूसरा फ़ैक्टर SMS हो तो SIM-स्वैप असली ख़तरा है। फिर भी, 2FA चालू करने पर आपको अकेले-पासवर्ड वाले अकाउंट से कहीं ज़्यादा हमला करना मुश्किल हो जाता है।',
  },
  {
    q: 'क्या 2FA ज़रूरी है?',
    a: 'क़ानून से नहीं, लेकिन बढ़ती सर्विसेज़ इसे थोप रही हैं: GitHub 2023 से कोड कंट्रिब्यूट करने वालों के लिए इसे माँगता है, कई बैंक और क्रिप्टो एक्सचेंज इसे ज़बरदस्ती चालू रखते हैं, और नियोक्ता अक्सर ऑफ़िस एक्सेस के लिए इसे अनिवार्य रखते हैं। बाकी जगहों पर यह वैकल्पिक है, पर बेहद सिफ़ारिशी। व्यावहारिक नियम: अपने सबसे क़ीमती अकाउंट्स में इसे ज़रूरी मानिए — पहले ईमेल, क्योंकि इनबॉक्स के क़ाबू में आने वाला बाक़ी सब कुछ रीसेट कर सकता है।',
  },
  {
    q: 'अब सब जगह 2FA क्यों है?',
    a: 'क्योंकि अकेले पासवर्ड का दौर ढह चुका है। बड़े पैमाने की लीक में अरबों क्रेडेंशियल सार्वजनिक हो गए, क्रेडेंशियल स्टफ़िंग हमले ऑटोमेटेड और सस्ते हो गए, और अब प्लेटफ़ॉर्म चोरी हुए अकाउंट्स की क़ीमत चुकाने पर हैं। रेगुलेटर्स ने भी धक्का दिया: NIST ने अपने अमेरिकी स्टैंडर्ड्स में SMS को ऑथेंटिकेशन से हटा दिया और यूरोपीय PSD2 मज़बूत कस्टमर ऑथेंटिकेशन माँगता है। जब कुछ दिग्गजों ने 2FA को नॉर्मल बनाया, बाक़ी सब सर्विसेज़ भी चल दीं।',
  },
  {
    q: 'TOTP, HOTP और OTP में क्या फ़र्क़ है?',
    a: 'OTP सिर्फ़ “वन-टाइम पासवर्ड” का छोटा रूप है। TOTP (टाइम-आधारित OTP, RFC 6238) कोड मौजूदा समय से बनता है, इसलिए हर 30 सेकंड में बदलता है। HOTP (RFC 4226) काउंटर पर टिका है: हर कोड सिर्फ़ एक बार इस्तेमाल होता है और काउंटर बढ़ता रहता है। लगभग हर “ऑथेंटिकेशन ऐप” सर्विस — Google, Microsoft, Discord, GitHub — TOTP इस्तेमाल करती है।',
  },
  {
    q: 'TOTP, SMS से बेहतर क्यों है?',
    a: 'SMS कोड टेलीफ़ोन नेटवर्क से सफ़र करते हैं, जहाँ SIM-स्वैप हमला उन्हें रोक या चुरा सकता है — और SMS की डिलीवरी, आख़िरकार, आराम से फेल हो सकती है। TOTP कोड आपके डिवाइस पर बनते हैं, कभी ट्रांसमिट नहीं होते और सेकंडों में एक्सपायर हो जाते हैं। NIST जैसी सिक्योरिटी संस्थाओं ने ऑथेंटिकेशन के लिए SMS को नामंज़ूर कर दिया है।',
  },
  {
    q: 'क्या फ़िशिंग साइट TOTP कोड चुरा सकती है?',
    a: 'हाँ — अगर आप ताज़ा बना कोड नक़ली पेज पर उसकी वैलिडिटी के दौरान (30 सेकंड) टाइप कर दें, तो हमलावर को काम करने वाला लॉगिन मिल जाता है। इसीलिए फ़िशिंग-रेसिस्टेंट फ़ैक्टर (फ़िज़िकल सिक्योरिटी कीज़ और पासकीज़, जो क्रिप्टोग्राफ़िक तौर पर असली डोमेन से बँधे होते हैं) जहाँ मिलें, सबसे मज़बूत विकल्प वही हैं। TOTP, SMS और पासवर्ड से तो बेहतर है, पर फ़िज़िकल कीज़ से नहीं।',
  },
  {
    q: 'अपनी 2FA सीक्रेट की कहाँ रखनी चाहिए?',
    a: 'पासवर्ड मैनेजर के एन्क्रिप्टेड वॉल्ट में, मास्टर कॉपी की तरह। इससे आप किसी भी भरोसेमंद डिवाइस पर — यहाँ तक कि 2facounter.com जैसे टूल वाले ब्राउज़र में — कोड दोबारा बना सकते हैं जब फ़ोन आस-पास न हो। हर सर्विस के 2FA चालू करने पर मिलने वाले बैकअप या रिकवरी कोड भी रखें; असली सहारा वही है।',
  },
];

