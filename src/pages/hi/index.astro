const title = 'ऑनलाइन 2FA कोड जेनरेटर — फ्री 2FA ऑथेंटिकेटर (TOTP)';
const description =
  'अपना 2FA कोड ऑनलाइन, तुरंत बनाएँ। फ्री 2FA ऑथेंटिकेटर जो आपके ब्राउज़र में ही चलता है: सीक्रेट की पेस्ट करें और लाइव TOTP कोड पाएँ। न ऐप, न साइन-अप, न फ़ोन।';

const faq = [
  {
    q: '2FA कैसे मिलता है?',
