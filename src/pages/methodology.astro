---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Editorial & Fact-Checking Methodology — 2FA COUNTER';
const description =
  'How 2FA COUNTER guides are written, fact-checked and kept current: sources, review cadence, corrections policy, and the security protocol our editors follow.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: title,
    description,
    url: 'https://2facounter.com/methodology/',
    about: {
      '@type': 'Organization',
      name: '2FA COUNTER',
      url: 'https://2facounter.com/',
    },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
        { '@type': 'ListItem', position: 2, name: 'About', item: 'https://2facounter.com/about/' },
        { '@type': 'ListItem', position: 3, name: 'Methodology', item: 'https://2facounter.com/methodology/' },
      ],
    },
  },
];
---

<Layout title={title} description={description} path="/methodology/" jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <div class="mx-auto max-w-[820px] px-4 py-20 sm:px-6 lg:py-24">
      <p class="section-label">Company</p>
      <h1 class="mt-3 font-display text-4xl tracking-normal text-ink sm:text-5xl">
        How we write and review our guides
      </h1>

      <div class="rich-text mt-12">
        <p>
          Every guide on 2facounter.com is written and fact-checked by the 2FA COUNTER team.
          This page documents exactly what that means, so you can hold us to it — and so you know
          when a page was last checked and how to get it corrected.
        </p>

        <h2>Sources</h2>
        <p>
          Each per-service guide is fact-checked against the service's own documentation at the
          time of writing: the official security, sign-in, or settings pages for enabling
          two-factor authentication and revealing the setup key. We do not rephrase forum posts
          or third-party blogs. Where a service's flow changes between regions or account types
          (Google Workspace policies, Microsoft Entra ID, AWS's IAM console), the guide says so
          instead of papering over the difference. The date on each guide card — "fact-checked
          against …, last reviewed …" — tells you how fresh that check is.
        </p>

        <h2>What we deliberately do not claim</h2>
        <p>
          Screens change. Menu wording changes. Our guides describe the flow as checked on the
          review date and call out the parts most likely to differ. We don't embed screenshots
          that could go stale, and we never write a step we haven't walked through ourselves. For
          services whose code format isn't the TOTP standard this tool implements — most notably
          Steam's Steam Guard — the guide says plainly that a standards-based generator cannot
          serve as a replacement, rather than hinting otherwise.
        </p>

        <h2>Review cadence and corrections</h2>
        <ul>
          <li>
            Every guide carries a <code>last reviewed</code> date. We re-check a guide when a
            service announces a security-settings change and at least whenever our data shows a
            material flow change.
          </li>
          <li>
            Spotted something wrong or outdated? Mail{" "}
            <a href="mailto:guides@2facounter.com">guides@2facounter.com</a>. We list what
            changed and update the review date once the correction is verified — major
            corrections get priority and typically ship within days.
          </li>
          <li>
            Security researchers: disclosures to{" "}
            <a href="mailto:security@2facounter.com">security@2facounter.com</a> are handled
            first-come, first-served, and every report gets a reply.
          </li>
        </ul>

        <h2>Editorial security protocol</h2>
        <p>
          The editors who test these flows follow the same rules we preach: accounts used in
          verification are dedicated test accounts whenever possible, secrets generated during
          testing are discarded and deleted, and no document, screenshot, or note containing a
          live setup key is ever stored. Verification happens with test keys or brand-new
          enrollments that are revoked straight after the check.
        </p>

        <h2>Language versions</h2>
        <p>
          The English pages on 2facounter.com are the source of truth. The other language
          versions are prepared with translation-assistance tooling and machine steps, then
          reviewed for structure, completeness, and technical accuracy before publication.
          A full native-speaker editorial pass is not yet complete for every language. Where a
          translation and the English text disagree, the English text governs. If a fluent reader
          spots a translation error, write to{" "}
          <a href="mailto:guides@2facounter.com">guides@2facounter.com</a> and we will correct
          it in both languages.
        </p>

        <h2>Independence</h2>
        <p>
          2FA COUNTER is not affiliated with any of the services the site references, is not
          paid by any of them, and accepts no placement deals. Guides are driven by what people
          ask for, not by what anyone wants promoted. Where a service makes a questionable
          default the safer route — SMS-only 2FA, mandatory app installs — we say so in the guide
          rather than beside it.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
