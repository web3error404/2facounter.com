// hreflang cluster for the translated article (+ x-default → English)
const alternates = [
  { hreflang: 'en', href: 'https://2facounter.com/what-is-2fa/' },
  { hreflang: 'vi', href: 'https://2facounter.com/vi/what-is-2fa/' },
  { hreflang: 'zh-Hans', href: 'https://2facounter.com/zh-cn/what-is-2fa/' },
  { hreflang: 'zh-Hant', href: 'https://2facounter.com/zh-tw/what-is-2fa/' },
