      { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
      { '@type': 'ListItem', position: 2, name: '2FA란 무엇인가?', item: 'https://2facounter.com/ko/what-is-2fa/' },
