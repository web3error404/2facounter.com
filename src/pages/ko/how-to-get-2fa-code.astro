import SiteFooter from '../../components/SiteFooter.astro';

const title = '2FA 인증번호 받는 법: 단계별 가이드 (TOTP)';
const description =
  '세 단계로 2FA 인증번호를 받는 방법: 설정 키를 꺼내 온라인 TOTP 생성기에 붙여넣고 실시간 코드를 복사하세요. 코드가 거부될 때의 해결 방법도 담았습니다.';

const faq = [
  {
    q: '설정 키는 어디서 찾나요?',
    a: '서비스가 인증 앱용 QR 코드를 보여 주는 바로 그 화면에 있습니다. “스캔이 안 되나요?”, “코드 직접 입력”, “설정 키 표시” 같은 링크를 찾아 누르면 Base32 문자열(또는 otpauth:// URI 전체)이 나타나며, 둘 다 생성기에서 그대로 쓸 수 있습니다.',
  },
  {
    q: '코드가 계속 거부되는데 어떻게 하죠?',
    a: '거의 항상 시계 오차 탓입니다. TOTP는 시간 기반이라 기기 시계가 겨우 반 분만 어긋나도 코드가 무효가 됩니다. 시스템 시간을 자동 동기화로 설정한 뒤 다시 시도하세요.',
  },
  {
    q: '휴대폰 앱에서 만드는 것과 같은 코드인가요?',
    a: '네. Google Authenticator, Authy, Microsoft Authenticator, 이 브라우저 도구까지 모든 인증 앱은 같은 비밀 키와 같은 시계로 같은 RFC 6238 TOTP 코드를 계산합니다. 서로 바꿔 쓸 수 있습니다.',
  },
  {
    q: '복구 코드도 여전히 필요한가요?',
    a: '네. 이 도구와 따로, 오프라인에 보관하세요. 비밀 키가 담긴 기기에 접근할 수 없게 되는 순간, 복구 코드가 계정으로 돌아가는 유일한 길입니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
