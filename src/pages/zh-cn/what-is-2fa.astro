const faqs = [
  {
    q: '什么是 2FA？',
    a: '2FA（双重验证）是指用两种不同的凭证证明“你是你”：你“知道”的东西（密码）加上你“拥有”的东西（每 30 秒变化一次的验证码、安全密钥或手机）。密码本身可能泄露或被猜中；有了第二重因素，泄露的密码单凭自身就无法打开你的账户。',
  },
