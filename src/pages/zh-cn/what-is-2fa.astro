<Layout title={title} description={description} path="/zh-cn/what-is-2fa/" lang="zh-Hans" jsonLd={jsonLd} alternates={alternates} image="/og-zh-cn.webp">
  <SiteHeader locale="zh-cn"
    links={[
      { href: '/zh-cn/', label: '2FA 验证码生成' },
      { href: '/zh-cn/how-to-get-2fa-code/', label: '如何获取 2FA 验证码' },
