---
/* SEO.astro — the single reusable <head> component.
   Every page renders its search/social head through this component from
   src/layouts/Layout.astro, so metadata, canonicals, alternates, and
   structured data are declared in one place. It renders search/social
   tags only: favicons, the web manifest, theme color, and font preloads
   stay in Layout.astro's own <head> since they are site chrome, not SEO. */

interface Props {
  title: string;
  description: string;
  /** Site-absolute path starting with "/" for canonical + og:url */
  canonicalPath: string;
  /** Social-share image path relative to the site root (defaults to /og.webp) */
  ogImage?: string;
  /** BCP 47 language of the page; also emits a self-referencing hreflang */
  lang?: string;
  /** hreflang alternates for translated versions of this page */
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Force the page out of the index (dev-only / scratch pages) */
  noindex?: boolean;
  /** Additional JSON-LD objects to inject */
  jsonLd?: object[];
  /** Article published date (ISO 8601) for news/article pages */
  datePublished?: string;
  /** Article modified date (ISO 8601) for news/article pages */
  dateModified?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/og.webp',
  lang = 'en',
  alternates = [],
  noindex = false,
  jsonLd = [],
  datePublished,
  dateModified,
} = Astro.props;

// Base URL from the configured `site` (hardcoded fallback keeps the
// canonical stable even if someone builds without astro.config.mjs).
const site = Astro.site?.origin ?? 'https://2facounter.com';
// Self-referencing canonical: home ("/") stays bare, like the current URLs.
const canonical = `${site}${canonicalPath === '/' ? '' : canonicalPath}`;

// Map BCP 47 to the hyphenated locale format og:locale expects.
const ogLocale: Record<string, string> = {
  en: 'en_US',
  vi: 'vi_VN',
  'zh-cn': 'zh_CN',
  'zh-hans': 'zh_CN',
  'zh-tw': 'zh_TW',
  'zh-hant': 'zh_TW',
  es: 'es_ES',
  ja: 'ja_JP',
  fr: 'fr_FR',
  de: 'de_DE',
  /* The pt pages are written in Brazilian Portuguese (você, câmera, tela,
     arquivo — verified across the homepage, generator strings and articles),
     so og:locale must be pt_BR; hreflang stays the generic "pt", which is
     the correct target for a single Portuguese version. */
  pt: 'pt_BR',
  ko: 'ko_KR',
  it: 'it_IT',
  hi: 'hi_IN',
  ar: 'ar_AR',
  bn: 'bn_IN',
  ru: 'ru_RU',
};
const locale = ogLocale[lang.toLowerCase()] ?? 'en_US';

// hreflang must include a self-referencing entry for every page in the
// set — add it automatically unless the caller already listed this page.
const selfLang = lang.toLowerCase();
const allAlternates = alternates.some((a) => a.hreflang.toLowerCase() === selfLang)
  ? alternates
  : [{ hreflang: lang, href: canonical }, ...alternates];

// Editorial pages (articles, guides) carry Article/HowTo JSON-LD. Use that
// to type the Open Graph object correctly and to surface the dates even when
// a page only declared them inside its structured data.
const editorialBlock = jsonLd.find((block) =>
  ['Article', 'NewsArticle', 'BlogPosting', 'HowTo'].includes(
    /** @type {any} */ (block)?.['@type'],
  ),
);
const ogType = editorialBlock ? 'article' : 'website';
const published = datePublished ?? /** @type {any} */ (editorialBlock)?.datePublished;
const modified = dateModified ?? /** @type {any} */ (editorialBlock)?.dateModified;

// og:locale:alternate tells social platforms which other translations exist.
// Deduplicate and skip the self entry / x-default.
const alternateLocales = [
  ...new Set(
    allAlternates
      .map((a) => a.hreflang.toLowerCase())
      .filter((code) => code !== 'x-default' && code !== selfLang)
      .map((code) => ogLocale[code])
      .filter(Boolean),
  ),
];

// Homepages declare a WebApplication, service guides and how-tos declare
// HowTo, and articles declare Article. Attach the shared author/publisher
// entity graph (and any missing image/reviewer fields) here, so every content
// type carries the same E-E-A-T signals without per-page duplication.
const enrichedJsonLd = jsonLd.map((block) => {
  const type = /** @type {any} */ (block)?.['@type'];
  const shared = {
    author: { '@type': 'Organization', name: '2FA COUNTER', url: site },
    publisher: {
      '@type': 'Organization',
      name: '2FA COUNTER',
      url: site,
      logo: {
        '@type': 'ImageObject',
        url: `${site}/web-app-manifest-512x512.png`,
        width: 512,
        height: 512,
      },
    },
    image: `${site}${ogImage}`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    // Tie every content block into the site-wide WebSite entity (which is
    // emitted globally) and declare the language, so the graph reads
    // page → WebSite → publisher rather than leaving a detached node.
    isPartOf: { '@type': 'WebSite', '@id': `${site}/#website` },
    inLanguage: lang,
  };

  if (type === 'WebApplication') {
    return { ...shared, screenshot: `${site}${ogImage}`, ...block };
  }
  if (type === 'Article') {
    return {
      ...shared,
      // `reviewedBy` is not a Schema.org property; `contributor` is the
      // closest valid CreativeWork signal for the editorial team.
      contributor: {
        '@type': 'Organization',
        name: '2FA COUNTER security editorial team',
        url: `${site}/methodology/`,
      },
      ...block,
    };
  }
  if (type === 'HowTo') {
    return { ...shared, ...block };
  }
  return block;
});
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="2FA COUNTER" />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
{noindex && <meta name="googlebot" content="noindex, nofollow" />}

{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && allAlternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={locale} />
{alternateLocales.map((alt) => <meta property="og:locale:alternate" content={alt} />)}
<meta property="og:site_name" content="2FA COUNTER" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={`${site}${ogImage}`} />
{/* og:image:type must match the actual file format (WebP since the 2026-11
    conversion; PNG-era pages and crawlers both handled by the mapper). */}
<meta property="og:image:type" content={ogImage.endsWith('.webp') ? 'image/webp' : 'image/png'} />
<meta property="og:image:width" content="2400" />
<meta property="og:image:height" content="1260" />
<!-- og:image:alt is localized by construction: every page passes its own
     translated title, which is the most accurate description of each card. -->
<meta property="og:image:alt" content={title} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
{ogType === 'article' && <meta property="article:author" content="2FA COUNTER" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@2facounter" />
<meta name="twitter:creator" content="@2facounter" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${site}${ogImage}`} />
<meta name="twitter:image:alt" content={title} />

{enrichedJsonLd.map((graph) => <script type="application/ld+json" set:html={JSON.stringify(graph)} />)}
