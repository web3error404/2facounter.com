---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReviewByline from './ReviewByline.astro';

export interface Props {
  serviceName: string;
  title: string;
  description: string;
  path: string;
  /** e.g. "GitHub / Discord" lead heading */
  intro: string;
  minutes: number;
  steps: { title: string; body: string }[];
  /** ISO 8601 "last fact-checked" date — emitted as dateModified in the head and HowTo JSON-LD */
  dateModified?: string;
  params?: string[];
  faqs: { q: string; a: string }[];
  /** Per-service CTA banner copy (each guide carries its own wording) */
  ctaTitle?: string;
  ctaBody?: string;
  /** Optional per-service deep-dive prose section (rendered between steps and FAQ) */
  deepDive?: { heading: string; blocks: { title: string; body: string }[] };
  /** ISO 8601 date the content was last fact-checked against the official docs */
  lastReviewed?: string;
  /* ── UI chrome overridables (all default to the current English copy) ──
     Present so a translated guide page can localize the layout without
     touching this file. Per-service copy already flows in as props. */
  /** "All guides" back-link target */
  backHref?: string;
  /** "All guides" back-link label */
  backLabel?: string;
  /** H1; defaults to “[service] 2FA setup” */
  heading?: string;
  /** Badge after the minutes count, defaults to “min · no app required” */
  minutesSuffix?: string;
  /** Start of the review line, before {service} — word-order varies by language */
  reviewedPrefix?: string;
  /** Label of the methodology link at the end of the review line */
  reviewedLinkLabel?: string;
  /** Primary CTA above the steps */
  generatorCta?: string;
  /** Steps heading */
  stepsHeading?: string;
  /** FAQ heading */
  faqHeading?: string;
  /** CTA banner button label */
  ctaButton?: string;
  /** Intl.DateTimeFormat locale for the visible review date (defaults en-GB) */
  dateFormatLocale?: string;
}

const {
  serviceName,
  title,
  description,
  path,
  intro,
  minutes,
  steps,
  dateModified,
  params = ['6 digits', '30-second period', 'SHA-1'],
  faqs,
  ctaTitle = 'Losing access is the real risk',
  ctaBody = `Save the ${serviceName} recovery codes in an encrypted password manager before you rely on
          any authenticator — phone app or this site. The recovery codes are your airbag;
          everything else is convenience.`,
  deepDive,
  lastReviewed,
  backHref = '/guides/',
  backLabel = 'All guides',
  heading,
  minutesSuffix = 'min · no app required',
  reviewedPrefix = 'Fact-checked against',
  reviewedLinkLabel = 'how we review guides',
  generatorCta,
  stepsHeading = 'Step by step',
  faqHeading = 'FAQ',
  ctaButton,
  dateFormatLocale = 'en-GB',
} = Astro.props;

// Visible "fact-checked" line: editors keep the last-reviewed date in frontmatter
// (falls back to dateModified so the JSON-LD and the visible line never drift).
const reviewed = lastReviewed ?? dateModified;
const reviewedLong = reviewed
  ? new Intl.DateTimeFormat(dateFormatLocale, { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(`${reviewed}T00:00:00Z`),
    )
  : undefined;

// Service-dependent defaults that can't be expressed in the props destructure
const headingText = heading ?? `${serviceName} 2FA setup`;
const generatorCtaText = generatorCta ?? `Open the generator for ${serviceName}`;
const ctaButtonText = ctaButton ?? `Generate ${serviceName} 2FA codes now`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2FA COUNTER', item: 'https://2facounter.com/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://2facounter.com/guides/' },
      { '@type': 'ListItem', position: 3, name: `${serviceName} 2FA`, item: `https://2facounter.com${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: title,
    description,
    totalTime: `PT${minutes}M`,
    ...(dateModified ? { dateModified } : {}),
    tool: [{ '@type': 'HowToTool', name: '2FA COUNTER (2facounter.com)' }],
    step: steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.body,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd} dateModified={dateModified}>
  <SiteHeader />
  <main id="main">
    <article class="mx-auto max-w-[820px] px-4 py-16 sm:px-6 lg:py-24">
      <div class="flex items-center gap-3">
        <a
          href={backHref}
          class="section-label -mx-2 -my-1 inline-block px-2 py-3 hover:text-accent-red"
        >← {backLabel}</a>
      </div>
      <h1 class="mt-4 font-display text-4xl tracking-normal text-ink sm:text-5xl">
        {headingText}
      </h1>
      <p class="mt-4 max-w-2xl text-lg font-medium text-ink">{intro}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="badge-stamp -rotate-2">{minutes} {minutesSuffix}</span>
        {
          params.map((p) => (
            <span class="font-mono text-[11px] font-semibold tracking-tight text-ink">{p}</span>
          ))
        }
      </div>
      {reviewedLong && (
        <p class="mt-3 font-mono text-[13px] text-muted">
          {reviewedPrefix} {serviceName}'s official documentation · last reviewed{" "}
          {reviewedLong} ·{" "}
          <a href="/methodology/" class="link">{reviewedLinkLabel}</a>
        </p>
      )}
      <ReviewByline />
      <a href="/#generator" class="btn-primary mt-8">
        {generatorCtaText}
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>

      <h2 class="mt-16 font-display text-[28px] leading-[1.2] tracking-normal text-ink">{stepsHeading}</h2>
      <ol class="mt-6 space-y-6">
        {
          steps.map((s, i) => (
            <li class="relative flex gap-5 rounded-xs border-2 border-ink bg-cream p-6 pt-7" style="box-shadow: var(--shadow-ticket)">
              <span class="absolute inset-x-3 top-1.5 border-t-2 border-dashed border-hairline-strong" aria-hidden="true"></span>
              <span class="shrink-0 font-numeric text-2xl font-black tracking-[-0.03125em] text-accent-red">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-ink">{s.title}</h3>
                <p class="mt-1.5 text-sm font-medium [overflow-wrap:anywhere] text-ink">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      {
        deepDive && (
          <section class="mt-16" aria-label={deepDive.heading}>
            <h2 class="font-display text-[28px] leading-[1.2] tracking-normal text-ink">
              {deepDive.heading}
            </h2>
            <div class="mt-6 space-y-6">
              {deepDive.blocks.map((b) => (
                <div>
                  <h3 class="text-lg font-bold text-ink">{b.title}</h3>
                  <p class="mt-1.5 text-sm font-medium leading-[1.7] [overflow-wrap:anywhere] text-ink">{b.body}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <h2 class="mt-16 font-display text-[28px] leading-[1.2] tracking-normal text-ink">{faqHeading}</h2>
      <div class="mt-6 divide-y-2 divide-dashed divide-hairline-strong">
        {
          faqs.map(({ q, a }) => (
            <details class="group px-1 py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-bold text-ink select-none marker:hidden">
                {q}
                <svg class="h-4 w-4 shrink-0 text-ink transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                </svg>
              </summary>
              <p class="pb-5 text-sm font-medium text-ink">{a}</p>
            </details>
          ))
        }
      </div>

      <div class="cta-banner on-dark mt-12">
        <h2 class="font-display text-lg tracking-normal text-primary">{ctaTitle}</h2>
        <p class="mt-2 text-sm font-medium text-cream/80">{ctaBody}</p>
        <a href="/#generator" class="btn-primary mt-5">{ctaButtonText}</a>
      </div>
    </article>
  </main>
  <SiteFooter />
</Layout>
