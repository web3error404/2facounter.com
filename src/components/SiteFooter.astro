---
import ShieldLogo from './ShieldLogo.astro';
import Wordmark from './Wordmark.astro';
import { LANGUAGES } from '../i18n/languages';

const year = new Date().getFullYear();

const defaultColumns = [
  {
    title: 'Product',
    links: [
      { href: '/#generator', label: 'Live generator' },
      { href: '/how-to-get-2fa-code/', label: 'Get a 2FA code' },
      { href: '/what-is-2fa/', label: 'What is 2FA?' },
      { href: '/#features', label: 'Features' },
      { href: '/#compatibility', label: 'Compatibility' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/totp-vs-passkeys/', label: 'TOTP vs passkeys' },
      { href: '/sim-swap-attacks/', label: 'SIM-swap attacks' },
      { href: '/authenticator-cloud-sync/', label: 'App cloud sync, compared' },
      { href: '/authenticator-for-pc/', label: 'Authenticator for PC' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { href: '/guides/', label: 'All guides' },
      { href: '/guides/google/', label: 'Google 2FA' },
      { href: '/guides/microsoft/', label: 'Microsoft 2FA' },
      { href: '/guides/discord/', label: 'Discord 2FA' },
      { href: '/guides/github/', label: 'GitHub 2FA' },
      { href: '/guides/steam/', label: 'Steam 2FA' },
      { href: '/guides/binance/', label: 'Binance 2FA' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/methodology/', label: 'Editorial methodology' },
      { href: '/contact/', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy/', label: 'Privacy policy' },
      { href: '/terms/', label: 'Terms of service' },
      { href: '/disclaimer/', label: 'Disclaimer' },
      { href: '/contact/', label: 'Report a security issue' },
      // Special case: reopens the analytics-consent banner (only rendered on
      // hosts where analytics is active — the script below unhides it).
      { href: '#', label: 'Cookie settings', id: 'cookie-settings' },
    ],
  },
];

interface Props {
  /** Nav columns — override with translated labels on localized pages */
  columns?: Array<{ title: string; links: Array<{ href: string; label: string }> }>;
  /** One-line description under the wordmark */
  tagline?: string;
  /** Title of the language-switcher column */
  languagesTitle?: string;
  /** Language links (default: all homepage language variants) */
  languages?: Array<{ href: string; label: string; hreflang?: string }>;
}

const {
  columns = defaultColumns,
  tagline = 'A zero-knowledge 2FA authenticator that runs entirely in your browser at 2facounter.com. No accounts, no servers, no phone required.',
  languagesTitle = 'Language',
  languages = LANGUAGES,
} = Astro.props;

// hreflang value matching each language-switcher URL (self-linking alternates)
const LANG_BY_HREF = new Map(LANGUAGES.map((l) => [l.href, l]));
const hreflangOf = (href: string) => LANG_BY_HREF.get(href)?.hreflang ?? 'en';
---

<footer class="on-dark bg-ink text-cream">
  <div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 xl:px-0">
    <div class="flex flex-col justify-between gap-12 lg:flex-row">
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2.5" aria-label="2FA COUNTER — home">
          <ShieldLogo class="h-9 w-9 shrink-0" />
          <Wordmark
            class="h-[13px] w-auto shrink-0 text-cream"
            shadow="rgb(0 0 0 / 0.4)"
          />
        </a>
        <p class="mt-4 font-mono text-[13px] leading-relaxed text-cream/75">
          {tagline}
        </p>
        <!-- Decorative barcode — the deli receipt mark -->
        <div
          class="mt-6 flex h-10 w-fit items-stretch gap-[2px] opacity-80"
          aria-hidden="true"
        >
          {[3, 1, 2, 1, 1, 3, 1, 2, 2, 1, 3, 1, 1, 2, 1, 3, 2, 1, 1, 3, 1, 1, 2, 1].map(
            (w, i) => (
              <span
                class="bg-cream"
                style={`width:${w}px;${i % 3 === 0 ? 'height:100%;' : 'height:80%;align-self:end;'}`}
              ></span>
            ),
          )}
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:min-w-0 lg:flex-1 lg:grid-cols-5" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h2 class="font-mono text-[13px] font-bold tracking-wide text-cream uppercase">
                {col.title}
              </h2>
              <ul class="mt-4 space-y-2">
                {col.links.map(({ href, label, id }) => (
                  <li>
                    <a
                      href={href}
                      id={id}
                      class:list={[
                        '-mx-2 -my-1 inline-block rounded-sm px-2 py-3 text-sm text-cream/75 hover:text-primary hover:underline hover:decoration-2 hover:underline-offset-2',
                        id && 'hidden',
                      ]}
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        {/* Language block spans two footer nav columns at every size: the
            nav is 2/4/5 columns wide (mobile/sm/lg), one column is ~120px
            even on desktop — two sub-columns of language names under one
            nav column would force "Tiếng Việt"-style wraps. Two nav columns
            give each item room for a single line at full 14px text.
            (The language column already wrapped to the nav's second row
            at lg — 6 items in a 5-column grid — so this only widens it.) */}
        <div class="col-span-2 min-w-0">
          <h2 class="font-mono text-[13px] font-bold tracking-wide text-cream uppercase">
            {languagesTitle}
          </h2>
          {/* Two-column language grid: row-major order halves the column
              height (8 + 7 rows). 12px column / 8px row gaps; each link is
              a one-line flex row — nowrap prevents wraps, flex keeps the
              text vertically centered, and RTL pages mirror automatically. */}
          <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2">
            {languages.map(({ href, label }) => (
              <li class="min-w-0">
                <a
                  hreflang={hreflangOf(href)}
                  href={href}
                  class="flex min-w-0 items-center whitespace-nowrap rounded-sm px-2 py-1 text-sm text-cream/75 hover:text-primary hover:underline hover:decoration-2 hover:underline-offset-2"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col justify-between gap-4 border-t-2 border-dashed border-cream/25 pt-8 font-mono text-[13px] text-cream/65 md:flex-row md:items-center"
    >
      <p>© {year} 2FA COUNTER · 2facounter.com</p>
      <p>
        Not affiliated with any of the services mentioned. 2FA is a security auxiliary — always
        keep your recovery codes offline.
      </p>
    </div>
  </div>
</footer>

<script>
  // "Cookie settings": visible only where the analytics consent script is
  // active (production hosts) — it un-hides the link and reopens the banner.
  const cookieSettings = document.getElementById('cookie-settings');
  const consentApi = window as unknown as { __2facConsentSettings?: () => void };
  if (cookieSettings) {
    if (typeof consentApi.__2facConsentSettings === 'function') {
      // Un-hide both ways: the [hidden] attribute AND the baked-in Tailwind
      // `hidden` class (display:none) — removing only the attribute used to
      // leave the link permanently invisible, breaking the privacy policy's
      // promised "Cookie settings" consent-revisit path.
      cookieSettings.hidden = false;
      cookieSettings.classList.remove('hidden');
    }
    cookieSettings.addEventListener('click', (e) => {
      e.preventDefault();
      consentApi.__2facConsentSettings?.();
    });
  }
</script>
