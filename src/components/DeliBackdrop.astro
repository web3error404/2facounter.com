---
/**
 * Deli backdrop — decorative shield-logo tiles pinned to the viewport
 * EDGES only (left/right gutters). Each tile is the favicon design
 * (favicon.svg): orange tile, ink border, dark shield + green logo dot.
 * On the orange canvas field the tile fill melts into the background and
 * the ink border + shield glyph read as stamped logo badges.
 *
 * Each tile bobs on its own staggered phase (negative delays start
 * mid-cycle so nothing moves in lockstep). The static tilt lives on the
 * INNER group: the .drift-item CSS animation sets `transform`, which
 * would override an SVG transform placed on the same element.
 *
 * Readability rule: tiles render only at ≥2xl (1536px) where the
 * centered 1200px content column leaves real gutters, and stay inside
 * the outer 260px bands — they can never slide behind body text while
 * scrolling. aria-hidden + pointer-events-none; motion is transform-only
 * and disabled by prefers-reduced-motion.
 */
---

<div class="pointer-events-none fixed inset-y-0 left-0 right-0 -z-10 hidden overflow-hidden 2xl:block" aria-hidden="true">
  <svg class="absolute h-0 w-0" aria-hidden="true">
    <symbol id="shield-tile" viewBox="0 0 512 512">
      <rect x="11" y="11" width="490" height="490" rx="112" fill="#e87a35" stroke="#2a1f1a" stroke-width="22"></rect>
      <g transform="translate(56.8 46) scale(16.6)">
        <path fill="#2a1f1a" d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
        <circle cx="12" cy="11.6" r="1.75" fill="#6ca632"></circle>
      </g>
    </symbol>
  </svg>

  <!-- ── LEFT gutter column ── -->
  <div class="absolute inset-y-0 left-0 w-[260px]">
    <svg class="drift-slow h-full w-full" viewBox="0 0 260 900" fill="none" preserveAspectRatio="xMidYMid slice">
      <!-- large logo tile -->
      <g class="drift-item" style="animation-delay:-3s">
        <g transform="rotate(-4 110 135)">
          <use href="#shield-tile" x="35" y="60" width="150" height="150"></use>
        </g>
      </g>

      <!-- medium logo tile -->
      <g class="drift-item drift-item-slow" style="animation-delay:-1.5s">
        <g transform="rotate(5 118 428)">
          <use href="#shield-tile" x="70" y="380" width="96" height="96"></use>
        </g>
      </g>

      <!-- small logo tile -->
      <g class="drift-item" style="animation-delay:-6s">
        <g transform="rotate(-7 180 670)">
          <use href="#shield-tile" x="150" y="640" width="60" height="60"></use>
        </g>
      </g>

      <!-- medium logo tile -->
      <g class="drift-item drift-item-slow" style="animation-delay:-2.2s">
        <g transform="rotate(3 95 845)">
          <use href="#shield-tile" x="40" y="790" width="110" height="110"></use>
        </g>
      </g>
    </svg>
  </div>

  <!-- ── RIGHT gutter column ── -->
  <div class="absolute inset-y-0 right-0 w-[260px]">
    <svg class="drift-slower h-full w-full" viewBox="0 0 260 900" fill="none" preserveAspectRatio="xMidYMid slice">
      <!-- large logo tile -->
      <g class="drift-item" style="animation-delay:-0.8s">
        <g transform="rotate(4 140 160)">
          <use href="#shield-tile" x="70" y="90" width="140" height="140"></use>
        </g>
      </g>

      <!-- small logo tile -->
      <g class="drift-item drift-item-slow" style="animation-delay:-5.1s">
        <g transform="rotate(-5 92 482)">
          <use href="#shield-tile" x="60" y="450" width="64" height="64"></use>
        </g>
      </g>

      <!-- medium logo tile -->
      <g class="drift-item" style="animation-delay:-2.6s">
        <g transform="rotate(-3 162 712)">
          <use href="#shield-tile" x="110" y="660" width="104" height="104"></use>
        </g>
      </g>

      <!-- large logo tile -->
      <g class="drift-item drift-item-slow" style="animation-delay:-3.9s">
        <g transform="rotate(6 100 910)">
          <use href="#shield-tile" x="40" y="850" width="120" height="120"></use>
        </g>
      </g>
    </svg>
  </div>
</div>
