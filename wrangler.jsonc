// Cloudflare Workers config — 2facounter.com is a fully static Astro site.
// worker.mjs is a thin wrapper: it 301-redirects www.2facounter.com to the
// apex (the canonical host) and fetches everything else from dist/.
{
  "name": "2facounter",
  "main": "worker.mjs",
  // Keep *.workers.dev reachable so existing links keep working; the script
  // redirects it to the canonical apex.
  "workers_dev": true,
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    // Send every request through the script so it can intercept www first;
    // the script then delegates asset serving to this binding.
    "binding": "ASSETS",
    "run_worker_first": true,
    // Serve the built 404 page for paths that don't match any asset.
    "not_found_handling": "404-page",
    // Serve /index.html for directory-style URLs (/, /es/, etc.).
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "2facounter.com", "custom_domain": true },
    { "pattern": "www.2facounter.com", "custom_domain": true }
  ]
}
