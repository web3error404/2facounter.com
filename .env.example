# Copy to .env and fill in real tokens — never commit .env itself.
# Both are optional: when unset, the build simply omits the meta tags.

# Google Search Console verification (https://search.google.com/search-console)
# Add the site → "HTML tag" verification → copy the token from
# <meta name="google-site-verification" content="TOKEN"> here.
PUBLIC_GSC_TOKEN=

# Bing Webmaster Tools (https://www.bing.com/webmasters)
# "HTML tag" verification → copy the token from
# <meta name="msvalidate.01" content="TOKEN"> here.
# Bing can also import the site from Google Search Console in one step.
PUBLIC_BING_TOKEN=
